{
  "name": "benefit-finder",
  "version": "0.10.0.beta.1",
  "private": true,
  "engines": {
    "node": "24.x.x"
  },
  "scripts": {
    "sync:usagov:theme": "bash ../../scripts/benefit-finder/sync-usagov-theme.sh",
    "prestart": "npm run sync:usagov:theme",
    "dev": "vite --host",
    "start": "vite --host",
    "build": "vite build",
    "postbuild": "mkdir -p build/assets && cp ../../web/modules/custom/usagov_benefit_finder/modules/usagov_benefit_finder_app/usagov_benefit_finder_page/css/benefit-finder.min.css build/assets/benefit-finder.min.css",
    "build:watch": "vite build --watch",
    "watch": "npm run build:watch",
    "serve": "vite preview",
    "test": "NODE_ENV=test vitest watch",
    "test:no-watch": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write '**/*.{js,jsx,json}'",
    "lint:scss": "stylelint 'src/**/*.scss'",
    "lint:scss:fix": "stylelint 'src/**/*.scss' --fix",
    "lint:js": "eslint . --ext .js,.jsx,.json",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:cspell:dev": "cspell lint '**'",
    "lint-staged": "lint-staged",
    "generate:component": "plop",
    "prebuild:storybook": "npm run sync:usagov:theme && npm run build",
    "dev:storybook": "npm run prebuild:storybook && storybook dev -p 6006",
    "build:storybook": "npm run prebuild:storybook && storybook build",
    "cy:prebuild:storybook": "NODE_ENV=test npm run sync:usagov:theme && npm run build",
    "cy:dev:storybook": "NODE_ENV=test npm run cy:prebuild:storybook && storybook dev -p 6006",
    "cy:build:storybook": "NODE_ENV=test npm run cy:prebuild:storybook && storybook build --test",
    "cy:run:e2e": "NODE_ENV=test npx cypress run --browser chrome",
    "cy:run:prod:e2e": "NODE_ENV=test npx cypress run --config-file cypress.prod.links.config.js --browser chrome",
    "cy:run:prod:links:e2e": "NODE_ENV=test npx cypress run --config-file cypress.prod.links.config.js --browser chrome",
    "cy:run:pipeline": "NODE_ENV=test concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\"   \"http-server ./storybook-static --port 6006 --silent\" -Y"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-modal": "^3.16.1",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.24.7",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-links": "^10.3.3",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@uswds/uswds": "^3.10.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "cspell": "^8.16.1",
    "cypress": "^15.16.0",
    "cypress-axe": "^1.7.0",
    "cypress-plugin-tab": "^2.0.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^3.6.0",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-storybook": "^10.3.3",
    "http-server": "^14.1.1",
    "install": "^0.13.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "npm": "^11.18.0",
    "playwright-webkit": "^1.58.2",
    "plop": "^4.0.1",
    "postcss": "^8.5.13",
    "prettier": "^3.3.3",
    "prop-types": "^15.8.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-scss": "^4.0.1",
    "sass-embedded": "^1.83.4",
    "storybook": "^10.3.3",
    "stylelint": "^17.5.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.1.2",
    "vite-plugin-eslint2": "^5.1.0",
    "vite-plugin-stylelint": "^6.1.0",
    "vitest": "^4.0.17",
    "wait-on": "^8.0.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
