FROM node:24-alpine
USER root

COPY .docker/src-reporter .

RUN apk upgrade --update \
    && apk add --no-cache --virtual .persistent-deps \
       jq \
       bash \
       curl \
       gettext \
       ca-certificates

RUN chmod +x /createreport.sh

WORKDIR /analytics-reporter
# npm ci installs exactly what package-lock.json pins, so the image is
# reproducible and Dependabot's lockfile updates actually take effect.
RUN npm ci
WORKDIR /
CMD ["./createreport.sh"]
