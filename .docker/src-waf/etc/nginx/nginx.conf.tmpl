load_module modules/ngx_http_modsecurity_module.so;

user nginx;
worker_processes auto;

pid /var/run/nginx.pid;

# Configure default error logger. access_log directive is in server block for port :80.
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  sendfile on;
  tcp_nopush on;

  client_max_body_size 512m;

  # As per USAGOV-1927 need to make sure the following value is greather than the timeout-value in
  #     .docker/src-www/etc/nginx/nginx.conf
  #     and
  #     .docker/src-cms/etc/nginx/nginx.conf
  keepalive_timeout 100s;

  resolver ${DNS_SERVER} valid=5s ipv6=off;

  real_ip_header X-Forwarded-For;
  set_real_ip_from 127.0.0.1/32;
  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  set_real_ip_from 52.222.122.97/32;
  set_real_ip_from 52.222.123.172/32;
  real_ip_recursive on;

  # access_log directive is in the primary server block (:80).
  # No space between '{' and '"' at the start of the JSON.
  # cf: https://github.com/cloud-gov/opensearch-boshrelease/blob/main/src/cf-logstash-filters/src/logstash-filters/snippets/app-logmessage-app.conf
  log_format json_with_cf  '{'
                              '"logType": "nginx-access", '

                              # This is combined format, except that we use $http_x_cf_forwarded_url
                              # in place of $request. It's included for tools that use this format.
                              # Both NR and OpenSearch promote it out of here and into the "message" field.
                              ' "message": "$remote_addr - $remote_user [$time_local] '
                                           '\\"$http_x_cf_forwarded_url\\" $status $body_bytes_sent '
                                           '\\"$http_referer\\" \\"$http_user_agent\\"", '

			       ' "remoteHost": "$remote_addr", '
			       ' "user": "$remote_user", '
			       ' "time_local": "$time_local", '
			       ' "time_iso8601": "$time_iso8601", '
			       ' "request": "$request", '
			       ' "status": $status, '
			       ' "size": $body_bytes_sent, '
			       ' "referer": "$http_referer", '
			       ' "userAgent": "$http_user_agent", '
			       ' "actualHost": "$host", '
			       ' "httpHost": "$http_host", '
			       ' "requestTime": $request_time, '
			       ' "requestUri": "$cf_request_uri", '
			       # Using "requested" instead of "forwarded" here so we can use the same
			       # fields in upstream logs; should help us collate them.
			       ' "requestedUrl": "$http_x_cf_forwarded_url", '
			       ' "requestedHost": "$cf_forwarded_host"'
                              '}';

  include /etc/nginx/conf.d/*.conf;
}
