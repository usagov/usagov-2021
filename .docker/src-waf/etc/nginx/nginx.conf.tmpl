load_module modules/ngx_http_modsecurity_module.so;

user nginx;
worker_processes auto;

pid /var/run/nginx.pid;

# Configure default error logger. access_log directive is in server block for port :80.
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  sendfile on;
  tcp_nopush on;

  client_max_body_size 512m;

  # As per USAGOV-1927 need to make sure the following vlaue is greather than the timeout-value in
  #     .docker/src-www/etc/nginx/nginx.conf
  #     and
  #     .docker/src-cms/etc/nginx/nginx.conf
  keepalive_timeout 100s;

  resolver ${DNS_SERVER} valid=5s ipv6=off;

  real_ip_header X-Forwarded-For;
  set_real_ip_from 127.0.0.1/32;
  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  set_real_ip_from 52.222.122.97/32;
  set_real_ip_from 52.222.123.172/32;
  real_ip_recursive on;

  # json_with_cf format for the primary server block (:80).
  log_format json_with_cf     '{'
                              ' "logType": "nginx-access", '
                              ' "remoteHost": "$remote_addr", '
                              ' "user": "$remote_user", '
                              ' "time": "$time_local", '
                              ' "request": "$request", '
                              ' "status": $status, '
                              ' "size": $body_bytes_sent, '
                              ' "referer": "$http_referer", '
                              ' "userAgent": "$http_user_agent", '
                              ' "requestTime": $request_time, '
                              ' "host": "$host", '
                              ' "forwardedHost": "$cf_forwarded_host", '
                              ' "requestUri": "$cf_request_uri", '
                              ' "httpHost": "$http_host", '
                              ' "forwardedUrl": "$http_x_cf_forwarded_url" '
                              ' }';

  include /etc/nginx/conf.d/*.conf;
}
