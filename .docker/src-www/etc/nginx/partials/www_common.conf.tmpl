    resolver ${DNS_SERVER} valid=5s ipv6=off;

    set_by_lua $request_uri_lowercase "return string.lower(ngx.var.uri)";

    proxy_hide_header Cache-Control;
    proxy_hide_header expires;
    add_header Cache-Control max-age=900;

    include /etc/nginx/partials/internal_redirects.conf;

    # USAGOV-2946: redirect all Spanish pages to English.
    # $es_redirect_target comes from partials/es-redirect-map.conf (generated by
    # scripts/es-redirect-map.php). Any other /es path goes to the English home page,
    # which also retires the Spanish 404. 302 (not 301) so this can be reverted.
    if ($es_redirect_target != "") {
      return 302 $es_redirect_target;
    }
    if ($request_uri_lowercase ~ ^/es(/|$)) {
      return 302 /;
    }

    include /etc/nginx/partials/s3proxy.conf;
    include /etc/nginx/partials/404s.conf;
    include /etc/nginx/partials/staticsite.conf;
