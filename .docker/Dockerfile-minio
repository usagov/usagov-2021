# Official minio/minio images were removed from Docker Hub and quay.io, and
# dl.min.io no longer serves binaries. Bitnami's legacy build of the same
# release ships both the minio server and mc client.
FROM bitnamilegacy/minio:2022.10.24

ARG BUILD_ENV
ENV BUILD_ENV=${BUILD_ENV:-none}

USER root
ENV HOME=/root

COPY .docker/src-minio/docker-entrypoint-minio.sh /docker-entrypoint-minio.sh
COPY .docker/src-minio/setup-bucket.sh /setup-bucket.sh
COPY .docker/src-minio/certs/ /root/.minio/certs/

# Add the zscaler certificate to the trusted certs only on local builds
# COPY cannot be conditional, but RUN can run conditional code.
COPY .docker/zscaler_cert.pem /tmp/zscaler.crt
RUN if [ x"${BUILD_ENV}" = x"LOCAL" ] ; then cp /tmp/zscaler.crt /usr/local/share/ca-certificates/zscaler.crt ; update-ca-certificates ; fi

RUN chmod +x /docker-entrypoint-minio.sh

ENTRYPOINT ["/docker-entrypoint-minio.sh"]

CMD ["server", "/data", "--console-address", ":9001"]
