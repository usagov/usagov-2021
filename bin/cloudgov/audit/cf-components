#!/usr/bin/env bash
#
# This script compiles a JSON report of our cf env's components.
#

set -e
set -o pipefail

die() { echo "$*" >&2; exit 2; }

status() { printf '[cf-components] %s\n' "$*" >&2; }

usage() {
  cat <<'EOF'
Usage: cf-components [--all] [--org ORG_NAME] [--space SPACE_NAME[,SPACE_NAME...]]

Options:
  -a, --all           Report on all organizations.
  -o, --org NAME      Report on a specific organization. Defaults to gsa-tts-usagov.
  -s, --space NAMES   Limit spaces by comma-separated name. Defaults to all.
  --to-file           Write the JSON report to a generated filename in the
                      current directory.
  -h, --help          Show this help message.

The report is emitted as pretty-printed JSON to stdout so it can be read in the
console or redirected to a file.
EOF
}

DEFAULT_ORG="gsa-tts-usagov"
all=false
org_name="$DEFAULT_ORG"
space_filter="all"
write_to_file=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -a|--all)
      all=true
      ;;
    -o|--org)
      shift
      [[ $# -gt 0 ]] || die "No arg for --org option"
      org_name="$1"
      ;;
    --org=*)
      org_name="${1#*=}"
      [[ -n "$org_name" ]] || die "No arg for --org option"
      ;;
    -s|--space)
      shift
      [[ $# -gt 0 ]] || die "No arg for --space option"
      space_filter="$1"
      ;;
    --space=*)
      space_filter="${1#*=}"
      [[ -n "$space_filter" ]] || die "No arg for --space option"
      ;;
    --to-file)
      write_to_file=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "Illegal option $1"
      ;;
  esac
  shift
done

append_json_item() { # $1 = array json, $2 = item json
  printf '%s\n%s\n' "$1" "$2" | jq -cs '.[0] + [.[1]]'
}

sanitize_filename_component() { # $1 = value
  jq -nr --arg value "$1" '
    $value
    | ascii_downcase
    | gsub("^\\s+|\\s+$"; "")
    | gsub("[^a-z0-9]+$"; "")
    | gsub("^[^a-z0-9]+"; "")
    | gsub("[^a-z0-9]+"; "-")
  '
}

cf_get_json() { # $1 = endpoint path
  local endpoint="$1"
  local response
  local error_message

  response=$(cf curl "$endpoint" 2>&1) || die "cf curl failed for ${endpoint}: ${response}"
  [[ -n "$response" ]] || die "cf curl returned an empty response for ${endpoint}. Check your Cloud Foundry login."

  jq -e . >/dev/null 2>&1 <<<"$response" || die "cf curl returned non-JSON output for ${endpoint}: ${response}"

  if jq -e '.errors? and (.errors | length > 0)' >/dev/null 2>&1 <<<"$response"; then
    error_message=$(jq -r '[.errors[] | (.detail // .title // .code // "Unknown Cloud Foundry API error")] | join("; ")' <<<"$response")
    die "cf curl returned an error for ${endpoint}: ${error_message}"
  fi

  printf '%s\n' "$response"
}

cf_paginated_resources() { # $1 = endpoint path
  local endpoint="$1"
  local separator='?'
  local first_page
  local page
  local total_pages

  if [[ "$endpoint" == *\?* ]]; then
    separator='&'
  fi

  first_page=$(cf_get_json "${endpoint}${separator}page=1&per_page=50") || return $?
  total_pages=$(jq -r '.pagination.total_pages // 1' <<<"$first_page")

  {
    printf '%s\n' "$first_page"
    for ((page=2; page<=total_pages; page++)); do
      cf_get_json "${endpoint}${separator}page=${page}&per_page=50"
    done
  } | jq -sc '[.[].resources[]?]'
}

build_domain_json() { # $1 = domain guid
  local domain_json

  domain_json=$(cf_get_json "/v3/domains/$1") || return $?
  jq -c '{
    guid,
    name,
    created_at,
    updated_at,
    internal,
    supported_protocols
  }' <<<"$domain_json"
}

build_org_quota_json() { # $1 = organization guid
  local organization_guid="$1"

  jq -c --arg organization_guid "$organization_guid" '
    [
      .[]
      | select(any(.relationships.organizations.data[]?; .guid == $organization_guid))
      | {
          guid,
          name,
          created_at,
          updated_at,
          apps: (.apps // null),
          services: (.services // null),
          routes: (.routes // null),
          domains: (.domains // null)
        }
    ]
    | first // null
  ' <<<"$ORGANIZATION_QUOTAS_ALL"
}

build_space_quota_json() { # $1 = space guid
  local space_guid="$1"

  jq -c --arg space_guid "$space_guid" '
    [
      .[]
      | select(any(.relationships.spaces.data[]?; .guid == $space_guid))
      | {
          guid,
          name,
          created_at,
          updated_at,
          apps: (.apps // null),
          services: (.services // null),
          routes: (.routes // null)
        }
    ]
    | first // null
  ' <<<"$SPACE_QUOTAS_ALL"
}

build_processes_json() { # $1 = app guid
  local app_guid="$1"

  jq -c --arg app_guid "$app_guid" '
    [
      .[]
      | select(.relationships.app.data.guid == $app_guid)
      | {
          guid,
          type,
          command,
          instances,
          memory_in_mb,
          disk_in_mb,
          log_rate_limit_in_bytes_per_second: (.log_rate_limit_in_bytes_per_second // null),
          health_check: (.health_check // null),
          readiness_health_check: (.readiness_health_check // null),
          ports: (.ports // []),
          created_at,
          updated_at
        }
    ]
    | sort_by(.type)
  ' <<<"$PROCESSES_ALL"
}

build_route_destinations_json() { # $1 = route guid
  local route_guid="$1"
  local destinations_response

  destinations_response=$(cf_get_json "/v3/routes/$route_guid/destinations") || return $?
  printf '%s\n%s\n' "$destinations_response" "$APP_NAMES_BY_GUID" | jq -cs '
      .[0] as $response
      | .[1] as $app_names
      | ($response.destinations // [])
      | map({
          guid,
          app: (
            if (.app.guid // null) == null then
              null
            else
              {
                guid: .app.guid,
                name: ($app_names[.app.guid] // null)
              }
            end
          ),
          process: (.process // null),
          protocol: (.protocol // null),
          port: (.port // null),
          weight: (.weight // null)
        })
      | sort_by((.app.name // ""), (.process.type // ""), (.port // 0))
    '
}

build_service_plan_json() { # $1 = service plan guid
  local service_plan_guid="$1"
  local service_plan_json
  local service_offering_guid
  local service_offering_json

  service_plan_json=$(jq -c --arg service_plan_guid "$service_plan_guid" '
    [.[] | select(.guid == $service_plan_guid)]
    | first
  ' <<<"$SERVICE_PLANS_ALL") || return $?

  if [[ "$service_plan_json" == "null" ]]; then
    printf 'null\n'
    return 0
  fi

  service_offering_guid=$(jq -r '.relationships.service_offering.data.guid // empty' <<<"$service_plan_json")
  if [[ -n "$service_offering_guid" ]]; then
    service_offering_json=$(jq -c --arg service_offering_guid "$service_offering_guid" '
      [.[] | select(.guid == $service_offering_guid)]
      | first
    ' <<<"$SERVICE_OFFERINGS_ALL") || return $?
  else
    service_offering_json='null'
  fi

  printf '%s\n%s\n' "$service_plan_json" "$service_offering_json" | jq -cs '
      .[0] as $plan
      | .[1] as $service_offering
      | $plan
      |
      {
        guid,
        name,
        description: (.description // null),
        available: (.available // null),
        free: (.free // null),
        service_offering: (
          if $service_offering == null then
            null
          else
            {
              guid: $service_offering.guid,
              name: $service_offering.name,
              description: ($service_offering.description // null),
              available: ($service_offering.available // null),
              tags: ($service_offering.tags // []),
              requires: ($service_offering.requires // []),
              shareable: ($service_offering.shareable // null),
              documentation_url: ($service_offering.documentation_url // null)
            }
          end
        )
      }
    '
}

build_service_credential_bindings_json() { # $1 = service instance guid
  local service_guid="$1"

  printf '%s\n%s\n' "$SERVICE_CREDENTIAL_BINDINGS_ALL" "$APP_NAMES_BY_GUID" | jq -cs \
    --arg service_guid "$service_guid" '
      .[0] as $bindings
      | .[1] as $app_names
      |
      [
        $bindings[]
        | select(.relationships.service_instance.data.guid == $service_guid)
        | {
            guid,
            name: (.name // null),
            type,
            created_at,
            updated_at,
            last_operation: (
              if (.last_operation // {} | type) == "object" and (.last_operation | length) > 0 then
                {
                  type: .last_operation.type,
                  state: .last_operation.state,
                  description: .last_operation.description,
                  updated_at: .last_operation.updated_at
                }
              else
                null
              end
            ),
            app: (
              if (.relationships.app.data.guid // null) == null then
                null
              else
                {
                  guid: .relationships.app.data.guid,
                  name: ($app_names[.relationships.app.data.guid] // null)
                }
              end
            )
          }
      ]
      | sort_by(.type, (.name // ""), (.app.name // ""))
    '
}

build_service_route_bindings_json() { # $1 = service instance guid
  local service_guid="$1"

  printf '%s\n%s\n' "$SERVICE_ROUTE_BINDINGS_ALL" "$ROUTE_URLS_BY_GUID" | jq -cs \
    --arg service_guid "$service_guid" '
      .[0] as $bindings
      | .[1] as $route_urls
      |
      [
        $bindings[]
        | select(.relationships.service_instance.data.guid == $service_guid)
        | {
            guid,
            route_service_url: (.route_service_url // null),
            created_at,
            updated_at,
            last_operation: (
              if (.last_operation // {} | type) == "object" and (.last_operation | length) > 0 then
                {
                  type: .last_operation.type,
                  state: .last_operation.state,
                  description: .last_operation.description,
                  updated_at: .last_operation.updated_at
                }
              else
                null
              end
            ),
            route: (
              if (.relationships.route.data.guid // null) == null then
                null
              else
                {
                  guid: .relationships.route.data.guid,
                  url: ($route_urls[.relationships.route.data.guid] // null)
                }
              end
            )
          }
      ]
      | sort_by((.route.url // ""), (.route_service_url // ""))
    ' <<<"$SERVICE_ROUTE_BINDINGS_ALL"
}

build_service_json() { # $1 = service guid
  local service_json
  local service_plan_guid
  local service_plan_json
  local credential_bindings_json
  local route_bindings_json

  service_json=$(cf_get_json "/v3/service_instances/$1") || return $?
  service_plan_guid=$(jq -r '.relationships.service_plan.data.guid // empty' <<<"$service_json")

  if [[ -n "$service_plan_guid" ]]; then
    service_plan_json=$(build_service_plan_json "$service_plan_guid") || return $?
  else
    service_plan_json='null'
  fi

  credential_bindings_json=$(build_service_credential_bindings_json "$1") || return $?
  route_bindings_json=$(build_service_route_bindings_json "$1") || return $?

  service_json=$(jq -c '{
    guid,
    name,
    created_at,
    updated_at,
    last_operation: (
      if (.last_operation // {} | type) == "object" and (.last_operation | length) > 0 then
        {
          type: .last_operation.type,
          state: .last_operation.state,
          description: .last_operation.description,
          updated_at: .last_operation.updated_at
        }
      else
        null
      end
    )
  }' <<<"$service_json") || return $?

  printf '%s\n%s\n%s\n%s\n' \
    "$service_json" \
    "$service_plan_json" \
    "$credential_bindings_json" \
    "$route_bindings_json" | jq -cs '
      .[0] as $service
      | .[1] as $service_plan
      | .[2] as $credential_bindings
      | .[3] as $route_bindings
      | $service
      |
      . + {
        service_plan: $service_plan,
        credential_bindings: $credential_bindings,
        route_bindings: $route_bindings,
        counts: {
          credential_bindings: ($credential_bindings | length),
          route_bindings: ($route_bindings | length)
        }
      }
    '
}

build_route_json() { # $1 = route guid
  local route_json
  local destinations_json

  route_json=$(cf_get_json "/v3/routes/$1") || return $?
  destinations_json=$(build_route_destinations_json "$1") || return $?
  route_json=$(jq -c '{
    guid,
    url,
    host,
    path,
    created_at,
    updated_at
  }' <<<"$route_json") || return $?

  printf '%s\n%s\n' "$route_json" "$destinations_json" | jq -cs '
    .[0] as $route
    | .[1] as $destinations
    | $route
    |
      . + {
        destinations: $destinations,
        counts: {
          destinations: ($destinations | length)
        }
      }
    '
}

build_attached_security_group_json() { # $1 = security group guid
  local group_json

  group_json=$(cf_get_json "/v3/security_groups/$1") || return $?
  jq -c '{
    guid,
    name,
    created_at,
    updated_at
  }' <<<"$group_json"
}

build_sidecars_json() { # $1 = app guid
  local app_guid="$1"
  local sidecars_json='[]'
  local sidecar_guid
  local sidecar_json

  while IFS= read -r sidecar_guid; do
    [[ -n "$sidecar_guid" ]] || continue
    sidecar_json=$(cf_get_json "/v3/sidecars/$sidecar_guid") || return $?
    sidecars_json=$(append_json_item "$sidecars_json" "$(jq -c '{
      guid,
      name,
      created_at,
      updated_at,
      command,
      process_types,
      memory_in_mb,
      origin
    }' <<<"$sidecar_json")") || return $?
  done < <(jq -r 'sort_by(.name) | .[].guid' <<<"$(cf_paginated_resources "/v3/apps/$app_guid/sidecars")")

  echo "$sidecars_json"
}

build_current_droplet_json() { # $1 = app guid
  local droplet_json

  droplet_json=$(cf_get_json "/v3/apps/$1/droplets/current") || return $?
  jq -c '
    if (.guid? // null) == null then
      null
    else
      {
        guid,
        state,
        created_at,
        updated_at,
        stack,
        image
      }
    end
  ' <<<"$droplet_json"
}

build_app_json() { # $1 = app guid
  local app_guid="$1"
  local app_json
  local current_droplet_json
  local processes_json
  local sidecars_json
  local task_count

  app_json=$(cf_get_json "/v3/apps/$app_guid") || return $?
  current_droplet_json=$(build_current_droplet_json "$app_guid") || return $?
  processes_json=$(build_processes_json "$app_guid") || return $?
  sidecars_json=$(build_sidecars_json "$app_guid") || return $?
  task_count=$(cf_get_json "/v3/apps/$app_guid/tasks" | jq -r '.pagination.total_results // 0') || return $?

  printf '%s\n%s\n%s\n%s\n%s\n' \
    "$app_json" \
    "$current_droplet_json" \
    "$processes_json" \
    "$sidecars_json" \
    "$task_count" | jq -cs '
      .[0] as $app
      | .[1] as $current_droplet
      | .[2] as $processes
      | .[3] as $sidecars
      | .[4] as $task_count
      | $app
      |
      {
      guid,
      name,
      created_at,
      updated_at,
      state,
      lifecycle: {
        type: .lifecycle.type,
        data: (.lifecycle.data // {})
      },
      current_droplet: $current_droplet,
      processes: $processes,
      task_count: $task_count,
      sidecars: $sidecars,
      counts: {
        processes: ($processes | length),
        sidecars: ($sidecars | length)
      }
    }'
}

build_space_json() { # $1 = space resource json
  local space_json="$1"
  local space_guid
  local space_name
  local space_quota_json
  local services_json='[]'
  local routes_json='[]'
  local attached_security_groups_json='[]'
  local running_security_groups_json
  local apps_json='[]'
  local service_count
  local route_count
  local attached_security_group_count
  local app_count
  local current_service
  local current_route
  local current_group
  local current_app
  local service_summary_json
  local route_summary_json
  local group_summary_json
  local app_summary_json
  local service_guid
  local service_name
  local route_guid
  local route_url
  local group_guid
  local group_name
  local app_guid
  local app_name

  space_guid=$(jq -r '.guid' <<<"$space_json")
  space_name=$(jq -r '.name' <<<"$space_json")
  space_quota_json=$(build_space_quota_json "$space_guid") || return $?
  service_count=$(jq --arg space_guid "$space_guid" '[.[] | select(.relationships.space.data.guid == $space_guid)] | length' <<<"$SERVICE_INSTANCES_ALL") || return $?
  route_count=$(jq --arg space_guid "$space_guid" '[.[] | select(.relationships.space.data.guid == $space_guid)] | length' <<<"$ROUTES_ALL") || return $?
  running_security_groups_json=$(cf_paginated_resources "/v3/spaces/$space_guid/running_security_groups") || return $?
  attached_security_group_count=$(jq 'length' <<<"$running_security_groups_json") || return $?
  app_count=$(jq --arg space_guid "$space_guid" '[.[] | select(.relationships.space.data.guid == $space_guid)] | length' <<<"$APPS_ALL") || return $?

  status "Building services for space ${space_name}: ${service_count}"
  current_service=0
  while IFS= read -r service_summary_json; do
    [[ -n "$service_summary_json" ]] || continue
    current_service=$((current_service + 1))
    service_guid=$(jq -r '.guid' <<<"$service_summary_json")
    service_name=$(jq -r '.name // "unnamed service"' <<<"$service_summary_json")
    status "Building service report for ${space_name}: ${current_service} of ${service_count} (${service_name})"
    services_json=$(append_json_item "$services_json" "$(build_service_json "$service_guid")") || return $?
  done < <(jq -c --arg space_guid "$space_guid" '
    [.[] | select(.relationships.space.data.guid == $space_guid)]
    | sort_by(.name)
    | .[]
  ' <<<"$SERVICE_INSTANCES_ALL")

  status "Building routes for space ${space_name}: ${route_count}"
  current_route=0
  while IFS= read -r route_summary_json; do
    [[ -n "$route_summary_json" ]] || continue
    current_route=$((current_route + 1))
    route_guid=$(jq -r '.guid' <<<"$route_summary_json")
    route_url=$(jq -r '.url // "unnamed route"' <<<"$route_summary_json")
    status "Building route report for ${space_name}: ${current_route} of ${route_count} (${route_url})"
    routes_json=$(append_json_item "$routes_json" "$(build_route_json "$route_guid")") || return $?
  done < <(jq -c --arg space_guid "$space_guid" '
    [.[] | select(.relationships.space.data.guid == $space_guid)]
    | sort_by(.url)
    | .[]
  ' <<<"$ROUTES_ALL")

  status "Building running security groups for space ${space_name}: ${attached_security_group_count}"
  current_group=0
  while IFS= read -r group_summary_json; do
    [[ -n "$group_summary_json" ]] || continue
    current_group=$((current_group + 1))
    group_guid=$(jq -r '.guid' <<<"$group_summary_json")
    group_name=$(jq -r '.name // "unnamed security group"' <<<"$group_summary_json")
    status "Building running security group for ${space_name}: ${current_group} of ${attached_security_group_count} (${group_name})"
    attached_security_groups_json=$(append_json_item "$attached_security_groups_json" "$(build_attached_security_group_json "$group_guid")") || return $?
  done < <(jq -c 'sort_by(.name) | .[]' <<<"$running_security_groups_json")

  status "Building apps for space ${space_name}: ${app_count}"
  current_app=0
  while IFS= read -r app_summary_json; do
    [[ -n "$app_summary_json" ]] || continue
    current_app=$((current_app + 1))
    app_guid=$(jq -r '.guid' <<<"$app_summary_json")
    app_name=$(jq -r '.name // "unnamed app"' <<<"$app_summary_json")
    status "Building app report for ${space_name}: ${current_app} of ${app_count} (${app_name})"
    apps_json=$(append_json_item "$apps_json" "$(build_app_json "$app_guid")") || return $?
  done < <(jq -c --arg space_guid "$space_guid" '
    [.[] | select(.relationships.space.data.guid == $space_guid)]
    | sort_by(.name)
    | .[]
  ' <<<"$APPS_ALL")

  printf '%s\n%s\n%s\n%s\n%s\n%s\n' \
    "$space_json" \
    "$space_quota_json" \
    "$services_json" \
    "$routes_json" \
    "$attached_security_groups_json" \
    "$apps_json" | jq -cs '
    .[0] as $space
    | .[1] as $quota
    | .[2] as $services
    | .[3] as $routes
    | .[4] as $attached_security_groups
    | .[5] as $apps
    | $space
    |
    {
      guid,
      name,
      created_at,
      updated_at,
      quota: $quota,
      services: $services,
      routes: $routes,
      attached_security_groups: $attached_security_groups,
      apps: $apps,
      counts: {
        services: ($services | length),
        routes: ($routes | length),
        attached_security_groups: ($attached_security_groups | length),
        apps: ($apps | length)
      }
    }'
}

build_org_json() { # $1 = organization resource json
  local org_json="$1"
  local org_guid
  local org_name
  local org_quota_json
  local domains_json='[]'
  local spaces_json='[]'
  local domain_count
  local space_count
  local current_domain
  local current_space
  local domain_summary_json
  local domain_guid
  local domain_name
  local space_json
  local candidate_spaces

  org_guid=$(jq -r '.guid' <<<"$org_json")
  org_name=$(jq -r '.name' <<<"$org_json")
  org_quota_json=$(build_org_quota_json "$org_guid") || return $?
  domain_count=$(jq --arg org_guid "$org_guid" '[.[] | select(.relationships.organization.data.guid == $org_guid)] | length' <<<"$DOMAINS_ALL") || return $?

  status "Building domains for organization ${org_name}: ${domain_count}"
  current_domain=0
  while IFS= read -r domain_summary_json; do
    [[ -n "$domain_summary_json" ]] || continue
    current_domain=$((current_domain + 1))
    domain_guid=$(jq -r '.guid' <<<"$domain_summary_json")
    domain_name=$(jq -r '.name // "unnamed domain"' <<<"$domain_summary_json")
    status "Building domain report for ${org_name}: ${current_domain} of ${domain_count} (${domain_name})"
    domains_json=$(append_json_item "$domains_json" "$(build_domain_json "$domain_guid")") || return $?
  done < <(jq -c --arg org_guid "$org_guid" '
    [.[] | select(.relationships.organization.data.guid == $org_guid)]
    | sort_by(.name)
    | .[]
  ' <<<"$DOMAINS_ALL")

  candidate_spaces=$(jq -c --arg org_guid "$org_guid" '
    [.[] | select(.relationships.organization.data.guid == $org_guid)]
    | sort_by(.name)
  ' <<<"$SPACES_ALL") || return $?

  if [[ "$SPACE_FILTER_MODE" == "selected" ]]; then
    candidate_spaces=$(jq -c --argjson selected_spaces "$SELECTED_SPACE_NAMES" '
      [.[] | select(.name as $space_name | $selected_spaces | index($space_name))]
    ' <<<"$candidate_spaces") || return $?
  fi
  space_count=$(jq 'length' <<<"$candidate_spaces") || return $?

  current_space=0
  while IFS= read -r space_json; do
    [[ -n "$space_json" ]] || continue
    current_space=$((current_space + 1))
    status "Building space report ${current_space}/${space_count}: $(jq -r '.name' <<<"$space_json")"
    spaces_json=$(append_json_item "$spaces_json" "$(build_space_json "$space_json")") || return $?
  done < <(jq -c '.[]' <<<"$candidate_spaces")

  printf '%s\n%s\n%s\n%s\n' \
    "$org_json" \
    "$org_quota_json" \
    "$domains_json" \
    "$spaces_json" | jq -cs '
    .[0] as $org
    | .[1] as $quota
    | .[2] as $domains
    | .[3] as $spaces
    | $org
    |
    {
      guid,
      name,
      created_at,
      updated_at,
      quota: $quota,
      domains: $domains,
      spaces: $spaces,
      counts: {
        domains: ($domains | length),
        spaces: ($spaces | length)
      }
    }'
}

build_security_groups_json() {
  local security_groups_json='[]'
  local group_count
  local current_group
  local group_summary_json
  local group_guid
  local group_name
  local group_json

  group_count=$(jq 'length' <<<"$SECURITY_GROUPS_ALL") || return $?
  status "Building global security group details: ${group_count}"
  current_group=0
  while IFS= read -r group_summary_json; do
    [[ -n "$group_summary_json" ]] || continue
    current_group=$((current_group + 1))
    group_guid=$(jq -r '.guid' <<<"$group_summary_json")
    group_name=$(jq -r '.name // "unnamed security group"' <<<"$group_summary_json")
    status "Building security group report: ${current_group} of ${group_count} (${group_name})"
    group_json=$(cf_get_json "/v3/security_groups/$group_guid") || return $?
    security_groups_json=$(append_json_item "$security_groups_json" "$(jq -c '{
      guid,
      name,
      created_at,
      updated_at,
      rules
    }' <<<"$group_json")") || return $?
  done < <(jq -c 'sort_by(.name) | .[]' <<<"$SECURITY_GROUPS_ALL")

  echo "$security_groups_json"
}

