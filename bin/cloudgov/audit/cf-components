#!/usr/bin/env bash
set -euo pipefail

die() { echo "$*" >&2; exit 2; }
status() { printf '[cf-components] %s\n' "$*" >&2; }

usage() {
  cat <<'EOF'
Usage: cf-components [OPTIONS]

Orchestrate component audit generation and translation.

Options:
  -a, --all                 Report on all organizations.
  -o, --org NAME            Report on a specific organization. Defaults to gsa-tts-usagov.
  -s, --space NAMES         Limit spaces by comma-separated name. Defaults to all.
  --json-only               Generate JSON only and write it to a file.
  --to-file                 Write JSON to a generated file.
  --output-json FILE        Write JSON report to FILE.
  --docx                    Translate the generated JSON into a DOCX report.
  --md                      Translate the generated JSON into markdown (legacy).
  --csv                     Translate the generated JSON into CSV files.
  --csv-diff OLD_JSON       Compare OLD_JSON to generated JSON and emit changes.csv.
  --out-dir DIR             Write DOCX/markdown/csv outputs into DIR.
  --all-formats, --af       Generate JSON, DOCX, and CSV outputs.
  -h, --help                Show this help message.

If no translation flags are provided, this command behaves like the JSON generator and emits JSON to stdout.
File outputs default to bin/cloudgov/audit/outputs/SCOPE-YYYYMMDDTHHMMSS/.
changes.csv is written to the component audit CSV directory only when
--csv-diff OLD_JSON is provided.
EOF
}

sanitize_scope() { # $1 = scope label
  jq -nr --arg value "$1" '
    $value
    | ascii_downcase
    | gsub("^\\s+|\\s+$"; "")
    | gsub("\\s*,\\s*"; "-")
    | gsub("[^a-z0-9]+"; "-")
    | gsub("^-+|-+$"; "")
    | if length == 0 then "all" else . end
  '
}

json_args=()
json_only=false
write_to_file=false
translate_md=false
translate_docx=false
translate_csv=false
translate_csv_diff=false
csv_diff_old_json=""
output_json=""
out_dir=""
output_scope="gsa-tts-usagov"
all_formats=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -a|--all)
      json_args+=(--all)
      output_scope="all"
      ;;
    -o|--org)
      shift
      [[ $# -gt 0 ]] || die "No arg for --org option"
      [[ -n "$1" ]] || die "No arg for --org option"
      json_args+=(--org "$1")
      output_scope="$1"
      ;;
    --org=*)
      json_args+=(--org="${1#*=}")
      [[ -n "${1#*=}" ]] || die "No arg for --org option"
      output_scope="${1#*=}"
      ;;
    -s|--space)
      shift
      [[ $# -gt 0 ]] || die "No arg for --space option"
      [[ -n "$1" ]] || die "No arg for --space option"
      json_args+=(--space "$1")
      output_scope="$1"
      ;;
    --space=*)
      json_args+=(--space="${1#*=}")
      [[ -n "${1#*=}" ]] || die "No arg for --space option"
      output_scope="${1#*=}"
      ;;
    --json-only)
      json_only=true
      ;;
    --to-file)
      write_to_file=true
      ;;
    --output-json)
      shift
      [[ $# -gt 0 ]] || die "No arg for --output-json option"
      [[ -n "$1" ]] || die "No arg for --output-json option"
      output_json="$1"
      ;;
    --output-json=*)
      output_json="${1#*=}"
      [[ -n "$output_json" ]] || die "No arg for --output-json option"
      ;;
    --md)
      translate_md=true
      ;;
    --docx)
      translate_docx=true
      ;;
    --csv)
      translate_csv=true
      ;;
    --csv-diff)
      shift
      [[ $# -gt 0 ]] || die "No arg for --csv-diff option"
      [[ -n "$1" ]] || die "No arg for --csv-diff option"
      translate_csv_diff=true
      csv_diff_old_json="$1"
      ;;
    --csv-diff=*)
      translate_csv_diff=true
      csv_diff_old_json="${1#*=}"
      [[ -n "$csv_diff_old_json" ]] || die "No arg for --csv-diff option"
      ;;
    --out-dir)
      shift
      [[ $# -gt 0 ]] || die "No arg for --out-dir option"
      [[ -n "$1" ]] || die "No arg for --out-dir option"
      out_dir="$1"
      ;;
    --out-dir=*)
      out_dir="${1#*=}"
      [[ -n "$out_dir" ]] || die "No arg for --out-dir option"
      ;;
    --all-formats|--af)
      all_formats=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "Illegal option $1"
      ;;
  esac
  shift
done

if [[ "$all_formats" == true ]]; then
  translate_docx=true
  translate_csv=true
fi

if [[ "$translate_csv_diff" == true && -z "$csv_diff_old_json" ]]; then
  die "--csv-diff requires an existing OLD_JSON argument"
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
json_script="$script_dir/cf-components-json"
md_script="$script_dir/cf-components-translate-md"
docx_script="$script_dir/cf-components-translate-docx"
csv_script="$script_dir/cf-components-translate-csv"
diff_script="$script_dir/cf-components-translate-csv-diff"
run_output_dir="$script_dir/outputs/$(sanitize_scope "$output_scope")-$(date +'%Y%m%dT%H%M%S')"

run_json_script() {
  if [[ "${#json_args[@]}" -gt 0 ]]; then
    "$json_script" "${json_args[@]}" "$@"
  else
    "$json_script" "$@"
  fi
}

if [[ "$translate_md" == false && "$translate_docx" == false && "$translate_csv" == false && "$translate_csv_diff" == false && "$json_only" == false && "$write_to_file" == false && -z "$output_json" ]]; then
  status "Generating JSON to stdout..."
  if [[ "${#json_args[@]}" -gt 0 ]]; then
    exec "$json_script" "${json_args[@]}"
  else
    exec "$json_script"
  fi
fi

if [[ -z "$output_json" ]]; then
  output_json="$run_output_dir/$(date +'%Y-%m')-component-audit.json"
fi
mkdir -p "$(dirname "$output_json")"

if [[ -z "$out_dir" ]]; then
  out_dir="$(dirname "$output_json")"
fi

csv_output_dir="$out_dir/$(basename "${output_json%.json}-csv")"

status "Generating JSON report to $output_json"
run_json_script --output-file "$output_json"

if [[ "$translate_csv" == true ]]; then
  mkdir -p "$csv_output_dir"
  status "Translating JSON to CSV files: $csv_output_dir"
  "$csv_script" --input "$output_json" --out-dir "$csv_output_dir"
fi

if [[ "$translate_csv_diff" == true ]]; then
  mkdir -p "$csv_output_dir"
  status "Generating changes.csv from $csv_diff_old_json to $output_json: $csv_output_dir/changes.csv"
  "$diff_script" "$csv_diff_old_json" "$output_json" --out-dir "$csv_output_dir"
fi

if [[ "$translate_docx" == true ]]; then
  mkdir -p "$out_dir"
  docx_output="$out_dir/$(basename "${output_json%.json}.docx")"
  status "Translating JSON to DOCX report: $docx_output"
  "$docx_script" --input "$output_json" --output "$docx_output"
fi

if [[ "$translate_md" == true ]]; then
  mkdir -p "$out_dir"
  md_output="$out_dir/$(basename "${output_json%.json}.md")"
  status "Translating JSON to markdown: $md_output"
  "$md_script" --input "$output_json" --output "$md_output"
fi

if [[ "$json_only" == true || "$write_to_file" == true || "$translate_md" == true || "$translate_docx" == true || "$translate_csv" == true || "$translate_csv_diff" == true ]]; then
  status "Component audit workflow complete. JSON: $output_json"
fi
