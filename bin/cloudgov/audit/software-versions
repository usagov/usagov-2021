#!/usr/bin/env bash
#
# Print Cloud.gov software versions for the monthly audit.
#
# This script does NOT ssh into any running app. Instead it reads the
# "SFTWR_AUDIT:" lines that every app already writes to stdout at container
# startup, which the log-shipper archives to a log-storage S3 bucket
# (fluent-bit-logs/). For each app we locate the log object(s) that cover the
# current container's start time, extract the latest SFTWR_AUDIT line, and map
# the reported versions into the audit-sheet row order.
#
# Bucket resolution (the logging topology is mid-migration):
#   - The bucket is resolved from the TARGET app space's own "log-storage"
#     service. For prod/stage this is the shared central bucket; dev has been
#     cut over to its own per-space bucket.
#   - The shared "tools" bucket is also read, because the egress proxies (in
#     the shared-egress space) drain there, and it serves as a fallback for any
#     app space not yet fully migrated.
#   - Two key layouts are handled automatically: the flat shared layout
#     (fluent-bit-logs/YYYY/MM/...) and the per-space layout
#     (fluent-bit-logs/<space>/YYYY/MM/...).
#
# Requirements: cf (v8), aws cli, python3, jq.
#
# Authoritative source of versions:
#   The SFTWR_AUDIT lines are emitted by:
#       cms               scripts/bootstrap.sh
#       www               scripts/static-bootstrap.sh
#       cron              .docker/src-cron/opt/cron/bootstrap.sh
#       waf               .docker/src-waf/docker-entrypoint-waf.sh
#       egress            .docker/src-egress/start.sh    (shared-egress/<space>-proxy)
#       api-proxy         .buildpack/api-proxy/start.sh
#       AnalyticsReporter .docker/src-reporter/createreport.sh
#
# KNOWN GAP (the "log-shipper trio"):
#   The log-shipper app does NOT yet emit a SFTWR_AUDIT line, so the three
#   values that used to be collected by ssh-ing into it cannot be read from S3:
#       - nginx openresty (log-shipper)
#       - Ubuntu Linux    (log-shipper)
#       - Fluent-bit      (log-shipper)
#   The log-shipper lives in a SEPARATE repository. To close this gap, add a
#   SFTWR_AUDIT emitter to the log-shipper's startup script in that repo, e.g.:
#       echo "SFTWR_AUDIT: app=${APP} space=${SPACE} os=\"${OS}\" \
#             nginx_openresty=${OPENRESTY_V} fluent_bit=${FLUENT_BIT_V}"
#   Once that line is shipped, update the mapping rows below (search for
#   LOG_SHIPPER_TODO) and the values will be picked up automatically.

set -eu

usage() {
  cat <<'EOF'
Print Cloud.gov software versions for the monthly audit.

Reads versions from the log-storage S3 bucket(s) (the SFTWR_AUDIT log lines
emitted at container startup). The bucket is resolved from the target app
space's own log-storage service; the shared "tools" bucket is also read for the
egress proxy and as a migration fallback. No ssh into running apps is performed.

Default output is one value per line, in the order used by the audit sheet, so it
can be pasted directly into a single spreadsheet column.

Usage:
  bin/cloudgov/audit/software-versions [--labels] [--space SPACE]

Options:
  --labels             Print "software<TAB>version" rows instead of version-only rows.
  -s, --space SPACE    App space to report on (dev|stage|prod|...). Defaults to current
                       cf target space, then prod.
  --org ORG            Cloud.gov org. Defaults to current target org, then gsa-tts-usagov.
  --tools-space SPACE  Space holding the shared log-shipper + log-storage bucket. Defaults to tools.
  --egress-space SPACE Space with egress proxy apps. Defaults to shared-egress.
  --egress-app APP     Egress proxy app. Defaults to SPACE-proxy (then SPACE-egress).
  -h, --help           Show this help.

Environment overrides:
  CF_ORG               Cloud.gov org. Defaults to current target org, then gsa-tts-usagov.
  APP_SPACE            App space to report on. Defaults to current target space, then PROD_SPACE, then prod.
  PROD_SPACE           Backward-compatible alias for APP_SPACE.
  TOOLS_SPACE          Tools space with the log-storage bucket. Defaults to tools.
  EGRESS_SPACE         Egress proxy space. Defaults to shared-egress.
  EGRESS_APP           Egress proxy app. Defaults to APP_SPACE-proxy (then APP_SPACE-egress).
  LOG_STORAGE_SERVICE  S3 service instance name in the tools space. Defaults to log-storage.
  WINDOW_BEFORE        Seconds before container start to scan for log objects. Default 1800.
  WINDOW_AFTER         Seconds after container start to scan for log objects. Default 1200.
EOF
}

WITH_LABELS=0
CLI_APP_SPACE=""
CLI_CF_ORG=""
CLI_TOOLS_SPACE=""
CLI_EGRESS_SPACE=""
CLI_EGRESS_APP=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --labels)
      WITH_LABELS=1
      ;;
    -s|--space)
      CLI_APP_SPACE=${2:-}
      if [ -z "$CLI_APP_SPACE" ]; then
        echo "No value provided for $1" >&2
        exit 2
      fi
      shift
      ;;
    --org)
      CLI_CF_ORG=${2:-}
      if [ -z "$CLI_CF_ORG" ]; then
        echo "No value provided for $1" >&2
        exit 2
      fi
      shift
      ;;
    --tools-space)
      CLI_TOOLS_SPACE=${2:-}
      if [ -z "$CLI_TOOLS_SPACE" ]; then
        echo "No value provided for $1" >&2
        exit 2
      fi
      shift
      ;;
    --egress-space)
      CLI_EGRESS_SPACE=${2:-}
      if [ -z "$CLI_EGRESS_SPACE" ]; then
        echo "No value provided for $1" >&2
        exit 2
      fi
      shift
      ;;
    --egress-app)
      CLI_EGRESS_APP=${2:-}
      if [ -z "$CLI_EGRESS_APP" ]; then
        echo "No value provided for $1" >&2
        exit 2
      fi
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Required command not found: $1" >&2
    exit 1
  fi
}

require_command cf
require_command aws
require_command jq
require_command python3

ORIGINAL_TARGET=$(cf target 2>/dev/null || true)
ORIGINAL_ORG=$(printf '%s\n' "$ORIGINAL_TARGET" | awk '/org:/ {print $2; exit}')
ORIGINAL_SPACE=$(printf '%s\n' "$ORIGINAL_TARGET" | awk '/space:/ {print $2; exit}')

CF_ORG=${CLI_CF_ORG:-${CF_ORG:-${ORIGINAL_ORG:-gsa-tts-usagov}}}
APP_SPACE=${CLI_APP_SPACE:-${APP_SPACE:-${ORIGINAL_SPACE:-${PROD_SPACE:-prod}}}}
TOOLS_SPACE=${CLI_TOOLS_SPACE:-${TOOLS_SPACE:-tools}}
EGRESS_SPACE=${CLI_EGRESS_SPACE:-${EGRESS_SPACE:-shared-egress}}
EGRESS_APP=${CLI_EGRESS_APP:-${EGRESS_APP:-${APP_SPACE}-proxy}}
LOG_STORAGE_SERVICE=${LOG_STORAGE_SERVICE:-log-storage}
WINDOW_BEFORE=${WINDOW_BEFORE:-1800}
WINDOW_AFTER=${WINDOW_AFTER:-1200}

SERVICE_KEY="audit-software-versions-$$"
# Spaces in which we created a service key, so cleanup can remove each one.
SERVICE_KEY_SPACES=""

cleanup() {
  for sp in $SERVICE_KEY_SPACES; do
    cf target -o "$CF_ORG" -s "$sp" >/dev/null 2>&1 || true
    cf delete-service-key "$LOG_STORAGE_SERVICE" "$SERVICE_KEY" -f >/dev/null 2>&1 || true
  done
  if [ -n "${ORIGINAL_ORG}" ] && [ -n "${ORIGINAL_SPACE}" ]; then
    cf target -o "$ORIGINAL_ORG" -s "$ORIGINAL_SPACE" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

target_space() {
  cf target -o "$CF_ORG" -s "$1" >/dev/null
}

# Earliest current-instance start time (ISO 8601 UTC) for an app, read from
# `cf app`. Empty string if the app cannot be found.
app_start_iso() {
  app=$1
  cf app "$app" 2>/dev/null \
    | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z' \
    | sort \
    | head -n 1
}

# Resolve the log-storage S3 bucket + credentials for a given space.
# On success prints "bucket<TAB>access_key<TAB>secret_key<TAB>region"; on
# failure prints nothing. Records the space for cleanup.
resolve_bucket() {
  space=$1
  if ! target_space "$space" 2>/dev/null; then
    return
  fi
  if ! cf service "$LOG_STORAGE_SERVICE" >/dev/null 2>&1; then
    return
  fi
  cf create-service-key "$LOG_STORAGE_SERVICE" "$SERVICE_KEY" >/dev/null 2>&1 || true
  case " $SERVICE_KEY_SPACES " in
    *" $space "*) : ;;
    *) SERVICE_KEY_SPACES="$SERVICE_KEY_SPACES $space" ;;
  esac
  creds=$(cf service-key "$LOG_STORAGE_SERVICE" "$SERVICE_KEY" 2>/dev/null | sed -n '/{/,$p')
  if [ -z "$creds" ]; then
    return
  fi
  bucket=$(printf '%s' "$creds" | jq -r '.credentials.bucket // empty')
  akey=$(printf '%s' "$creds" | jq -r '.credentials.access_key_id // empty')
  skey=$(printf '%s' "$creds" | jq -r '.credentials.secret_access_key // empty')
  region=$(printf '%s' "$creds" | jq -r '.credentials.region // empty')
  if [ -z "$bucket" ] || [ -z "$akey" ]; then
    return
  fi
  printf '%s\t%s\t%s\t%s\n' "$bucket" "$akey" "$skey" "$region"
}

# --- Resolve the log-storage bucket(s) -----------------------------------------
# Primary: the target app space's own log-storage service. For prod/stage this
# is the shared central bucket; dev has its own. Secondary: the shared "tools"
# bucket, which receives the egress proxy logs and acts as a fallback.
echo "Resolving log-storage bucket for ${CF_ORG}/${APP_SPACE} ..." >&2
APP_BUCKET_LINE=$(resolve_bucket "$APP_SPACE")
if [ -z "$APP_BUCKET_LINE" ]; then
  echo "Could not resolve a log-storage bucket for ${CF_ORG}/${APP_SPACE}." >&2
fi

echo "Resolving shared log-storage bucket for ${CF_ORG}/${TOOLS_SPACE} ..." >&2
TOOLS_BUCKET_LINE=$(resolve_bucket "$TOOLS_SPACE")
if [ -z "$TOOLS_BUCKET_LINE" ]; then
  echo "Could not resolve a log-storage bucket for ${CF_ORG}/${TOOLS_SPACE}." >&2
fi

if [ -z "$APP_BUCKET_LINE" ] && [ -z "$TOOLS_BUCKET_LINE" ]; then
  echo "No log-storage buckets available; cannot read versions." >&2
  exit 1
fi

# --- Determine each app's container start time ---------------------------------
# Targets are passed to python as "space|app|startISO" lines.
TARGETS=""
add_target() {
  TARGETS="${TARGETS}${1}|${2}|${3}
"
}

echo "Looking up container start times for apps in ${CF_ORG}/${APP_SPACE} ..." >&2
target_space "$APP_SPACE"
for app in cms www waf cron api-proxy AnalyticsReporter; do
  start=$(app_start_iso "$app")
  echo "  ${app}: ${start:-<not found>}" >&2
  add_target "$APP_SPACE" "$app" "$start"
done

echo "Looking up egress proxy start time in ${CF_ORG}/${EGRESS_SPACE} ..." >&2
target_space "$EGRESS_SPACE"
EGRESS_START=$(app_start_iso "$EGRESS_APP")
if [ -z "$EGRESS_START" ] && [ "$EGRESS_APP" = "${APP_SPACE}-proxy" ]; then
  EGRESS_APP="${APP_SPACE}-egress"
  EGRESS_START=$(app_start_iso "$EGRESS_APP")
fi
echo "  ${EGRESS_APP}: ${EGRESS_START:-<not found>}" >&2
add_target "$EGRESS_SPACE" "$EGRESS_APP" "$EGRESS_START"

echo "Reading versions from S3 log-storage (no ssh)." >&2
echo "App space: ${APP_SPACE}  Egress: ${EGRESS_SPACE}/${EGRESS_APP}" >&2

# --- Extract versions from S3 and emit the audit rows --------------------------
# Each bucket line is "bucket<TAB>access_key<TAB>secret_key<TAB>region".
# Multiple lines (app-space bucket and tools bucket) are passed newline-joined.
BUCKETS=$(printf '%s\n%s\n' "$APP_BUCKET_LINE" "$TOOLS_BUCKET_LINE")

APP_SPACE="$APP_SPACE" \
EGRESS_SPACE="$EGRESS_SPACE" \
EGRESS_APP="$EGRESS_APP" \
WITH_LABELS="$WITH_LABELS" \
WINDOW_BEFORE="$WINDOW_BEFORE" \
WINDOW_AFTER="$WINDOW_AFTER" \
TARGETS="$TARGETS" \
BUCKETS="$BUCKETS" \
python3 <<'PYEOF'
import datetime
import json
import os
import shlex
import subprocess
import sys

APP_SPACE = os.environ["APP_SPACE"]
EGRESS_SPACE = os.environ["EGRESS_SPACE"]
EGRESS_APP = os.environ["EGRESS_APP"]
WITH_LABELS = os.environ.get("WITH_LABELS", "0") == "1"
WINDOW_BEFORE = int(os.environ.get("WINDOW_BEFORE", "1800"))
WINDOW_AFTER = int(os.environ.get("WINDOW_AFTER", "1200"))
PREFIX = "fluent-bit-logs/"
UTC = datetime.timezone.utc


def log(msg):
    sys.stderr.write(msg + "\n")
    sys.stderr.flush()


# Buckets to scan, de-duplicated by bucket name. Each entry carries its own AWS
# credentials and the set of spaces whose logs may live there, so we can build
# the right key layout (flat shared vs per-space-prefixed) for each.
buckets = []
_seen_buckets = {}
for raw in os.environ.get("BUCKETS", "").splitlines():
    raw = raw.strip()
    if not raw:
        continue
    cols = raw.split("\t")
    if len(cols) < 4 or not cols[0]:
        continue
    name, akey, skey, region = cols[0], cols[1], cols[2], cols[3]
    if name in _seen_buckets:
        continue
    entry = {
        "name": name,
        "env": {
            "AWS_ACCESS_KEY_ID": akey,
            "AWS_SECRET_ACCESS_KEY": skey,
            "AWS_DEFAULT_REGION": region,
        },
    }
    _seen_buckets[name] = entry
    buckets.append(entry)

if not buckets:
    log("No log-storage buckets were resolved; nothing to scan.")
    sys.exit(1)


def aws_env(entry):
    env = dict(os.environ)
    env.update(entry["env"])
    return env

# Value used for versions that cannot yet be sourced from the logs.
LOG_SHIPPER_TODO = "TODO: add SFTWR_AUDIT emitter in log-shipper repo"


def parse_iso(value):
    if not value:
        return None
    try:
        return datetime.datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=UTC)
    except ValueError:
        return None


def load_json(text):
    try:
        return json.loads(text, strict=False)
    except Exception:
        return None


# Parse "space|app|startISO" lines into targets.
targets = {}
for line in os.environ.get("TARGETS", "").splitlines():
    line = line.strip()
    if not line:
        continue
    parts = line.split("|")
    if len(parts) < 2:
        continue
    space, app = parts[0], parts[1]
    start = parse_iso(parts[2]) if len(parts) > 2 else None
    targets[(space, app)] = {"start": start, "msg": None, "msg_time": None}


def list_keys(entry, prefix):
    result = subprocess.run(
        [
            "aws", "s3api", "list-objects-v2",
            "--bucket", entry["name"],
            "--prefix", prefix,
            "--query", "Contents[].Key",
            "--output", "text",
        ],
        capture_output=True,
        text=True,
        env=aws_env(entry),
    )
    if result.returncode != 0:
        return []
    return [k for k in result.stdout.split() if k and k != "None"]


def list_common_prefixes(entry, prefix):
    """List the immediate child "directories" under prefix."""
    result = subprocess.run(
        [
            "aws", "s3api", "list-objects-v2",
            "--bucket", entry["name"],
            "--prefix", prefix,
            "--delimiter", "/",
            "--query", "CommonPrefixes[].Prefix",
            "--output", "text",
        ],
        capture_output=True,
        text=True,
        env=aws_env(entry),
    )
    if result.returncode != 0:
        return []
    return [p for p in result.stdout.split() if p and p != "None"]


def key_time(key):
    # .../YYYY/MM/DD/HH/MM/SS  (trailing six path segments are the timestamp)
    parts = key.split("/")[-6:]
    if len(parts) != 6:
        return None
    try:
        y, mo, d, h, mi, s = (int(p) for p in parts)
        return datetime.datetime(y, mo, d, h, mi, s, tzinfo=UTC)
    except ValueError:
        return None


def layout_roots(entry):
    """Return the prefixes that precede the YYYY/MM/DD/HH/MM/SS path in this
    bucket. Flat shared buckets use "fluent-bit-logs/"; per-space buckets use
    "fluent-bit-logs/<space>/". Detected by inspecting the first path segment
    under fluent-bit-logs/ (a 4-digit year means flat; anything else is a
    space directory)."""
    roots = []
    has_flat_year = False
    for child in list_common_prefixes(entry, PREFIX):
        leaf = child[len(PREFIX):].rstrip("/")
        if len(leaf) == 4 and leaf.isdigit():
            has_flat_year = True
        else:
            roots.append(child)  # e.g. fluent-bit-logs/dev/
    if has_flat_year:
        roots.append(PREFIX)
    if not roots:
        roots.append(PREFIX)
    return roots


# Build the set of hour stamps to list, based on each target's window.
# Objects are keyed by their open time, which precedes the messages they hold,
# so scan a window around each container's start time.
hour_stamps = set()
now = datetime.datetime.now(UTC)
for info in targets.values():
    start = info["start"]
    if start is None:
        # No known start time: fall back to the most recent few hours.
        win_start = now - datetime.timedelta(hours=6)
        win_end = now
    else:
        win_start = start - datetime.timedelta(seconds=WINDOW_BEFORE)
        win_end = start + datetime.timedelta(seconds=WINDOW_AFTER)
    info["win_start"] = win_start
    info["win_end"] = win_end
    # Include an extra leading hour so an object opened just before win_start
    # (but still covering it) is listed.
    cursor = (win_start - datetime.timedelta(hours=1)).replace(
        minute=0, second=0, microsecond=0
    )
    while cursor <= win_end:
        hour_stamps.add(cursor.strftime("%Y/%m/%d/%H"))
        cursor += datetime.timedelta(hours=1)

# Detect each bucket's key layout, then list candidate objects per bucket.
# candidates maps (bucket_name, key) -> bucket entry, so downloads use the
# correct credentials.
log(f"Detecting layout and listing objects across {len(buckets)} bucket(s) ...")
candidates = {}
for entry in buckets:
    roots = layout_roots(entry)
    log(f"  s3://{entry['name']}/ roots: {', '.join(roots)}")
    found = 0
    for root in roots:
        for stamp in sorted(hour_stamps):
            for key in list_keys(entry, root + stamp + "/"):
                if key_time(key) is not None:
                    candidates[(entry["name"], key)] = entry
                    found += 1
    log(f"    {found} candidate object(s).")
log(f"Found {len(candidates)} candidate object(s) total.")

# Keep only keys whose open time can plausibly cover a target window. An object
# opened at kt holds messages until the next object opens (~16 min), so a key is
# relevant if its open time is within [win_start - 20min, win_end].
relevant = []
for (bucket_name, key), entry in candidates.items():
    kt = key_time(key)
    for info in targets.values():
        if info["win_start"] - datetime.timedelta(minutes=20) <= kt <= info["win_end"]:
            relevant.append((key, entry))
            break
# Sort by key time, newest first, so each app's startup line is found quickly.
relevant.sort(key=lambda pair: pair[0])
log(f"{len(relevant)} object(s) cover the container-start windows; scanning newest-relevant first.")
relevant.reverse()

def all_found():
    return all(info["msg"] is not None for info in targets.values())


def each_audit_line(entry, key):
    proc = subprocess.Popen(
        ["aws", "s3", "cp", f"s3://{entry['name']}/{key}", "-"],
        stdout=subprocess.PIPE,
        env=aws_env(entry),
    )
    try:
        for raw in proc.stdout:
            if b"SFTWR_AUDIT" not in raw:
                continue
            yield raw.decode("utf-8", "replace")
    finally:
        proc.stdout.close()
        proc.wait()


for idx, (key, entry) in enumerate(relevant, 1):
    if all_found():
        log("All target apps resolved; stopping scan early.")
        break
    remaining = sorted(
        app for (space, app), info in targets.items() if info["msg"] is None
    )
    log(f"[{idx}/{len(relevant)}] scanning s3://{entry['name']}/{key} (still missing: {', '.join(remaining)})")
    hits = 0
    for line in each_audit_line(entry, key):
        rec = load_json(line)
        if not rec:
            continue
        tags = load_json(rec.get("tags", "{}")) or {}
        app = tags.get("app_name")
        space = tags.get("space_name")
        if (space, app) not in targets:
            continue
        msg = (rec.get("message") or "").strip()
        if "SFTWR_AUDIT:" not in msg:
            continue
        # rec time looks like 2026-06-18T14:56:32.399861+00:00
        raw_time = rec.get("time", "")
        rec_time = parse_iso(raw_time.split(".")[0].split("+")[0] + "Z")
        info = targets[(space, app)]
        keep = False
        if info["msg"] is None:
            keep = True
        elif rec_time and info["start"] and info["msg_time"]:
            # Prefer the line closest to the container start time.
            if abs((rec_time - info["start"]).total_seconds()) < abs(
                (info["msg_time"] - info["start"]).total_seconds()
            ):
                keep = True
        elif rec_time and info["msg_time"] and rec_time > info["msg_time"]:
            keep = True
        if keep:
            info["msg"] = msg
            info["msg_time"] = rec_time
            hits += 1
    if hits:
        log(f"    matched {hits} SFTWR_AUDIT line(s) in this object.")

log("Scan complete.")


def fields_for(space, app):
    info = targets.get((space, app))
    if not info or not info["msg"]:
        return {}
    body = info["msg"].split("SFTWR_AUDIT:", 1)[1].strip()
    out = {}
    try:
        tokens = shlex.split(body)
    except ValueError:
        tokens = body.split()
    for tok in tokens:
        key, sep, val = tok.partition("=")
        if sep:
            out[key] = val
    return out


def g(space, app, field):
    return fields_for(space, app).get(field)


def combine(a, b, label_a, label_b):
    if a is None and b is None:
        return None
    if a == b:
        return a
    if a is None:
        return f"{label_b}: {b}"
    if b is None:
        return f"{label_a}: {a}"
    return f"{label_a}: {a}; {label_b}: {b}"


# Audit-sheet rows, in the exact order expected by the spreadsheet column.
rows = [
    ("Alpine Linux (CMS, WWW)", combine(g(APP_SPACE, "cms", "os"), g(APP_SPACE, "www", "os"), "cms", "www")),
    ("Alpine Linux (CRON)", g(APP_SPACE, "cron", "os")),
    ("nginx (CMS, WWW)", combine(g(APP_SPACE, "cms", "nginx"), g(APP_SPACE, "www", "nginx"), "cms", "www")),
    ("Debian Linux (WAF)", g(APP_SPACE, "waf", "os")),
    ("nginx (WAF)", g(APP_SPACE, "waf", "nginx")),
    # LOG_SHIPPER_TODO: replace with g(LOG_SHIPPER_SPACE, LOG_SHIPPER_APP, "nginx_openresty")
    ("nginx openresty (log-shipper)", LOG_SHIPPER_TODO),
    ("caddy (egress proxy)", g(EGRESS_SPACE, EGRESS_APP, "caddy")),
    ("caddy (AnalyticsReporter)", g(APP_SPACE, "AnalyticsReporter", "caddy")),
    ("cloudfoundry cli (cron)", g(APP_SPACE, "cron", "cf_cli")),
    ("Drupal", g(APP_SPACE, "cms", "drupal")),
    ("AWS RDS MySQL", g(APP_SPACE, "cms", "aws_rds_mysql")),
    ("Node (NodeJS, node build container)", g(APP_SPACE, "cms", "node_build")),
    ("Node (NodeJS, AR)", g(APP_SPACE, "AnalyticsReporter", "node")),
    ("PHP", g(APP_SPACE, "cms", "php")),
    ("python (api-proxy)", g(APP_SPACE, "api-proxy", "python")),
