#!/bin/bash

# This script deploys an egress proxy. It adds the URLs of any s3 buckets bound to the apps
# in the space the egress serves to the proxy's allow list, along with the contents of the
# apps-egress-allow.acl file.
#
# This script operates in two modes:
# - Full setup (-full): Sets up credentials and provides them to the proxy AND the apps in the
#   protected space, restarting all the apps in the process. This is the way to deploy a
#   proxy "from scratch" or to rotate credentials, but in the latter case it will incur
#   some down time for egress requests due to credential mismatch (especially if there
#   are multiple apps in the protected space).
#
# - Redeploy (default): Updates the allow list as described above and pushes the app, but does not
#   modify credentials. This is the way to update the code on the proxy or update the allow
#   list with minimal disruption. Redeploy will fail if the specified egress proxy app is not
#   already deployed. :-)

set -e
set -o pipefail

# we might be running in circleci
if [ -f /home/circleci/project/env.local ]; then
  . /home/circleci/project/env.local
fi
# we might be running from a local dev machine
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
if [ -f $SCRIPT_DIR/env.local ]; then
  . $SCRIPT_DIR/env.local
fi
if [ -f ./env.local ]; then
  . ./env.local
fi

SCRIPT_DIR="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )"
if [ -f $SCRIPT_DIR/../deploy/includes ]; then
  . $SCRIPT_DIR/../deploy/includes
else
    echo "File does not exist: $SCRIPT_DIR/../deploy/includes"
    exit 1
fi

usage="
$0: (Re-)deploy egress proxy for an environment

Usage:
   $0 -h
   $0 [-full] protectedspace [egressspace] [egressorg]

Options:
-h:             show help and exit
protectedspace: the space in which the apps that use this proxy live
-full:         establish fresh credentials and restart apps in protectedspace
egressspace:    space with public egress (default: shared-egress)
egressorg:      org where the public egress space is (default: <currentorg>)

If the environment variable DRYRUN is set, the planned commands will be echoed rather
than invoked. For example:
   DRYRUN=1 $0 somespace someorg

Requirements:
- You must be a SpaceDeveloper in the protected_space and the egress_space.

NOTES:
- This script deploys a single egress proxy app to serve all apps in
  the protected space. Unless -full is specified, it will exit if the app
  is not already deployed.
- Updated code will be pushed.
- Allow/deny lists will include the contents of the
  apps-egress-allow.acl and apss-egress-deny.acl files in this
  script's directory, respectively.
- Any S3 buckets bound to an app in the protected space will
  automatically be added to the Allow list.
- In -full mode, this script WILL CHANGE the username:password
  credentials of an existing proxy, and will run setup-egress-for-apps
  on each app in the protected space to set the PROXYROUTE env
  variable and restart the app.
"

if [[ "$1" == "-h" ]]; then
    echo "${usage}"
    exit 1
fi

fullDeploy=0

if [[ "$1" == "-full" ]]; then
    fullDeploy=1
    shift
fi

# Protect the space requested, not necessarily the current space.
protectedSpace=$1

# Grab the org and space where the command was run
startorg=$(   cf target | grep org:   | awk '{ print $2 }')
startspace=$(   cf target | grep space:   | awk '{ print $2 }')

egressspace=${1:-shared-egress}
egressorg=${2:-$startorg}

# Drop them off where we found them
function popspace() {
    echo "Popspace: ${startorg}/${startspace}"
    cf target -o "$startorg" -s "$startspace" > /dev/null 2>&1
}
# trap popspace exit
trap popspace err

# Try to switch to the egress org+space, error out if it's not there
cf target -o "$egressorg" -s "$egressspace" > /dev/null 2>&1 ||
    (echo "ERROR: Space ${egressorg}/${egressspace} is not available!" && exit 1)

# Try to switch to the protected org+space, error out if it's not there
cf target -o "$startorg" -s "$protectedSpace" > /dev/null 2>&1 ||
    (echo "ERROR: Space ${startorg}/${protectedSpace} is not available!" && exit 1)

echo "Using Egress Space ${egressorg}/${egressspace}"

# Get the proxy name. Apparently we want to allow for a couple of conventions here -- still needed?
proxyname=""
if [ -z "$proxyname" ]; then
    egressapps=$(cf apps | tail -n +4 | awk '{print $1}')
    proxyname=$(echo "$egressapps" | grep -e "^${protectedSpace}-proxy\b" | head -n 1 || echo "")
    if [ -z "$proxyname" ]; then
      proxyname=$(echo "$egressapps" | grep "^${protectedSpace}-egress" | head -n 1 || echo "")
    fi
fi
if [ -z "$proxyname" ]; then
    proxyname="${protectedSpace}-proxy"
fi
echo "Using egress proxy app name: $proxyname"

# NO: go to target space here! (let's add a targetspace())
# popspace



# If DRYRUN is set, don't run the commands, but echo them.
if [ -n "${DRYRUN}" ]; then
    echo "DRYRUN specified -- very little action will be taken"
    echo ""
    output="echo # "
fi

# setup only one egress app per space, and add any S3 buckets bound to apps in that space to the allow.acl.
# echo "Gather Bucket names from App Space"
buckethosts=""
applist=$( cf apps | tail -n +4 | awk '{print $1}' )
for app in $applist ; do
    echo "Gathering buckets for $app"
    VCAP_SERVICES=$(cf env "$app" | sed -n -e "/VCAP_SERVICES/,\$p" | sed -e "/VCAP_APPLICATION:/,\$d" | sed 's/VCAP_SERVICES: //g' | jq -r )
    n=$(echo -E "$VCAP_SERVICES" | jq -r '.s3 | length')
    i=0
    while [ $i -lt "$n" ]
    do
        # Add attached buckets to the allow list
        BUCKET=$(            echo -E "$VCAP_SERVICES" | jq -r ".s3[$i].credentials.bucket")
        AWS_ENDPOINT=$(      echo -E "$VCAP_SERVICES" | jq -r ".s3[$i].credentials.endpoint" | uniq )
        AWS_ENDPOINT_ALT=$(  echo -E "$AWS_ENDPOINT"  | sed 's/s3\-us\-/s3.us-/g' | uniq )
        AWS_FIPS_ENDPOINT=$( echo -E "$VCAP_SERVICES" | jq -r ".s3[$i].credentials.fips_endpoint" | uniq )
        # Add both the FIPS and non-FIPS hostnames
        buckethosts="$buckethosts ${BUCKET}.${AWS_ENDPOINT} ${BUCKET}.${AWS_ENDPOINT_ALT} ${BUCKET}.${AWS_FIPS_ENDPOINT}"
        ((i+=1))
    done
done
echo "Setting up instance flag: $instances"
echo "Using buckets: $buckethosts"

# We need these files to exist for each app, even if they're empty.
echo "Touching $SCRIPT_DIR/apps-egress-deny.acl"
$output touch $SCRIPT_DIR/apps-egress-deny.acl
echo "Touching $SCRIPT_DIR/apps-egress-allow.acl"
$output touch $SCRIPT_DIR/apps-egress-allow.acl

# Assemble vars.yml file content

echo "Regenerate user/pass for use by proxy"
username="$(uuidgen)"
password="$(uuidgen)"
proxyroute="https://$username:$password@$proxyname.apps.internal:61443"

# Auto-allow bound buckets
proxydeny=$(  cat $SCRIPT_DIR/apps-egress-deny.acl || echo "" )
proxyallow=$( cat $SCRIPT_DIR/apps-egress-allow.acl <(echo "$buckethosts") || echo "" )

# Normalize into a YAML multiline block form
proxydeny=$(  echo "$proxydeny"  | sed 's/ \{1,\}/\n/g' | sed '/^\s*$/d' | sed 's/^/  /'  )
proxyallow=$( echo "$proxyallow" | sed 's/ \{1,\}/\n/g' | sed '/^\s*$/d' | sed 's/^/  /'  )

echo "Create ./manifest-egress-vars.yml"
$output touch ./manifest-egress-vars.yml
echo "proxyname: $proxyname
hostname: $proxyname
username: $username
password: $password
proxyroute: $proxyroute
proxydeny: |
$proxydeny
proxyallow: |
$proxyallow
" > ./manifest-egress-vars.yml

# If the caddy binary is not already in place, retrieve the latest from cg-egress-proxy.
# (Latest? We are trusting their review process.)
caddy_bin_file=$SCRIPT_DIR/../../.docker/src-egress/caddy
if [ -f $caddy_bin_file ]; then
    echo "Caddy binary already exists at $caddy_bin_file"
else
    echo "Getting latest caddy binary from cg-egress-proxy repo and saving it to $caddy_bin_file"
    $output git clone --depth 1 https://github.com/GSA-TTS/cg-egress-proxy.git tmp-caddy-build
    $output cp -p tmp-caddy-build/proxy/caddy $caddy_bin_file
    $output rm -rf tmp-caddy-build
fi

# Set up instance counts for each proxy app
instances="-i 1"
if [ "$protectedSpace" == "dev" ]; then
    instances="-i 1"
elif [ "$protectedSpace" == "stage" ]; then
    instances="-i 1"
elif [ "$protectedSpace" == "prod" ]; then
    instances="-i 2"
elif [ "$protectedSpace" == "tools" ]; then
    instances="-i 2"
fi

# Deploy the proxy app
echo "Deploy Egress Proxy App"
$output cf target -o "$egressorg" -s "$egressspace" 2>&1 > /dev/null
$output cf push $proxyname -f ./manifest-egress.yml $instances --no-wait --strategy rolling --vars-file ./manifest-egress-vars.yml

if [ -n "${DRYRUN}" ]; then
    echo "# vars-file content:"
    echo "$(cat ./manifest-egress-vars.yml | sed -e 's/^/#  -->/')"
fi

popspace

if [ $fullDeploy -eq 1 ]; then
    # While it seems it would be desirable to run setup-egress-for-apps with the
    # whole list at once, in practice that script will stop after a slow-to-restart
    # app doesn't complete in time.
    for app in $applist ; do
	echo "$SCRIPT_DIR/setup-egress-for-apps $app"
	$output $SCRIPT_DIR/setup-egress-for-apps $app
    done
fi
