#!/bin/sh
#
# This script will attempt to store a container image on docker hub
# to be used when launching cloud.gov images
#

DOCKERUSER=${DOCKERUSER:-gsatts}
DOCKERREPO=${DOCKERREPO:-usagov-2021}

echo docker tag $DOCKERUSER/$DOCKERREPO:reporter-$CIRCLE_BUILD_NUM $DOCKERUSER/$DOCKERREPO:reporter-$RDIG
docker tag $DOCKERUSER/$DOCKERREPO:reporter-$CIRCLE_BUILD_NUM $DOCKERUSER/$DOCKERREPO:reporter-$RDIG

echo "docker push $DOCKERUSER/$DOCKERREPO:reporter-$RDIG"
docker push $DOCKERUSER/$DOCKERREPO:reporter-$RDIG
