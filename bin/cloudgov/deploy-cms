#!/usr/bin/env bash
#
# This script will attempt to deploy a cms app by tag
#

# we might be running in circleci
if [ -f /home/circleci/project/env.local ]; then
  . /home/circleci/project/env.local
fi
# we might be running from a local dev machine
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
if [ -f $SCRIPT_DIR/env.local ]; then
  . $SCRIPT_DIR/env.local
fi
INCLUDES_BASE=$SCRIPT_DIR/../deploy/includes
if [ -f $INCLUDES_BASE ]; then
  . $INCLUDES_BASE
else
   echo Cannot find $INCLUDES_BASE
   exit 1
fi
if [ -f ./env.local ]; then
  . ./env.local
fi

# just testing?
if [ x$1 = x"--dryrun" ]; then
  echo=echo
  dryrun=$1
  shift
fi

DOCKERUSER=${DOCKERUSER:-gsatts}
DOCKERREPO=${DOCKERREPO:-usagov-2021}

APP_SPACE=${1:-please-provide-space-name-as-first-argument}
APP_SPACE=$(echo "$APP_SPACE" | tr '[:upper:]' '[:lower:]')
assertCurSpace $APP_SPACE
shift

APP_ORG=getOrg

CTAG=${1:-latest}
CDIGEST=${2:-}

EGRESS_SPACE='shared-egress'
#if [ "$APP_SPACE" == "dev-dr" ]; then
#    EGRESS_SPACE='shared-egress-dr'
#fi

# The Image digest for this tag should be looked up from cloud.gov storage
# Any tag with a stored Image digest should be referenced by hash instead of tag

function restartApp { #appname
  app=$1
  if [ -z "$app" ]; then
    echo "ERROR: appname is required"
    exit 1
  fi
  echo cf restart $app --no-wait --strategy rolling
  $echo cf restart $app --no-wait --strategy rolling
}

function pushApp { #appname
  app=$1
  if [ -z "$app" ]; then
    echo "ERROR: appname is required"
    exit 1
  fi

  instances="-i 1"
  if [ "$APP_SPACE" == "prod" ]; then
    instances="-i 2"
  elif [ "$APP_SPACE" == "stage" ]; then
    instances="-i 1"
  elif [ "$APP_SPACE" == "dev" ]; then
    instances="-i 1"
  fi

  if [ -z "$CDIGEST" ]; then
    echo "Deploying ${DOCKERUSER}/${DOCKERREPO}:${app}-${CTAG}"
    if [ -z "$DOCKERHUB_ACCESS_TOKEN" ]; then
      echo  cf push $app $instances --docker-image ${DOCKERUSER}/${DOCKERREPO}:${app}-${CTAG} --strategy rolling
      $echo cf push $app $instances --docker-image ${DOCKERUSER}/${DOCKERREPO}:${app}-${CTAG} --strategy rolling
      RETVAL=$?
    else
      export CF_DOCKER_PASSWORD=$DOCKERHUB_ACCESS_TOKEN
      echo  cf push $app $instances --docker-image ${DOCKERUSER}/${DOCKERREPO}:${app}-${CTAG} --docker-username $DOCKERHUB_USERNAME --strategy rolling
      $echo cf push $app $instances --docker-image ${DOCKERUSER}/${DOCKERREPO}:${app}-${CTAG} --docker-username $DOCKERHUB_USERNAME --strategy rolling
      RETVAL=$?
      unset CF_DOCKER_PASSWORD
    fi
  else
    echo "Deploying ${DOCKERUSER}/${DOCKERREPO} ${app}-${CTAG} via digest ${CDIGEST}"
    if [ -z "$DOCKERHUB_ACCESS_TOKEN" ]; then
      echo  cf push $app $instances --docker-image ${DOCKERUSER}/${DOCKERREPO}${CDIGEST} --strategy rolling
      $echo cf push $app $instances --docker-image ${DOCKERUSER}/${DOCKERREPO}${CDIGEST} --strategy rolling
      RETVAL=$?
    else
      export CF_DOCKER_PASSWORD=$DOCKERHUB_ACCESS_TOKEN
      echo  cf push $app $instances --docker-image ${DOCKERUSER}/${DOCKERREPO}${CDIGEST} --docker-username $DOCKERHUB_USERNAME --strategy rolling
      $echo cf push $app $instances --docker-image ${DOCKERUSER}/${DOCKERREPO}${CDIGEST} --docker-username $DOCKERHUB_USERNAME --strategy rolling
      RETVAL=$?
      unset CF_DOCKER_PASSWORD
    fi
  fi
  if [ $RETVAL -ne 0 ]; then
    echo "ERROR: cf push failed ($RETVAL)"
    exit $RETVAL
  fi
}

function setupRoutes { #appname
  app=$1
  if [ -z "$app" ]; then
    echo "ERROR: appname is required"
    exit 1
  fi

  createRoute apps.internal cms-$APP_SPACE-usagov
  mapRoute $app apps.internal cms-$APP_SPACE-usagov
  
  if [ "$APP_SPACE" == "prod" ]; then
     createRoute usa.gov cms
     mapRoute $app usa.gov cms
  else
    createRoute usa.gov cms-$APP_SPACE
    mapRoute $app usa.gov cms-$APP_SPACE
  fi
}

function setupEgress { #appname
  app=$1
  if [ -z "$app" ]; then
    echo "ERROR: appname is required"
    exit 1
  fi

  if [ x$echo != x ]; then
    echo DRYRUN=yes $SCRIPT_DIR/setup-egress-for-apps $app --no-restart
    DRYRUN=yes $SCRIPT_DIR/setup-egress-for-apps $app --no-restart
  else
    echo $SCRIPT_DIR/setup-egress-for-apps $app --no-restart
    $SCRIPT_DIR/setup-egress-for-apps $app --no-restart
    RETVAL=$?
    if [ $RETVAL -ne 0 ]; then
      echo "ERROR: setup-egress-for-apps failed ($RETVAL)"
      exit $RETVAL
    fi
  fi
}

function setUSPSCreds {
  cfSetEnv cms USPS_API_ENV $USPS_API_ENV
  cfSetEnv cms USPS_USERID $USPS_USERID
  cfSetEnv cms USPS_PASSWORD $USPS_PASSWORD
}

function setCallCenterEWTBucket {
  cfSetEnv cms CALL_CENTER_EWT_BUCKET $CALL_CENTER_EWT_BUCKET
}

if existsCFApp cms; then
  setupRoutes cms
  setupEgress cms
  setUSPSCreds
  setCallCenterEWTBucket
  if existsCFService "cache-service"; then
      bindServiceToApp cms cache-service
  fi
  if existsCFService "s3forAnalyticsReporter"; then
      bindServiceToApp cms s3forAnalyticsReporter
  fi
  pushApp cms
else
  cf set-env cms SKIP_DRUPAL_BOOTSTRAP "skip"
  pushApp cms
  setupRoutes cms
  setupEgress cms
  if existsCFService "cache-service"; then
      bindServiceToApp cms cache-service
  fi
  if existsCFService "s3forAnalyticsReporter"; then
      bindServiceToApp cms s3forAnalyticsReporter
  fi
  setUSPSCreds
  setCallCenterEWTBucket
  cf set-env cms SKIP_DRUPAL_BOOTSTRAP ""
  restartApp cms
fi
