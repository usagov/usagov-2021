#!/usr/bin/env bash
#
# This script will attempt to deploy a cms app by tag
#

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# Optional includes: we might be running in circleci, or a local dev machine
for f in /home/circleci/project/env.local $SCRIPT_DIR/env.local ./env.local; do
  if [ -f $f ]; then
    . $f
  fi
done

# Mandatory includes:
for inc in $SCRIPT_DIR/../deploy/includes; do
  if [ ! -f $inc ]; then
    echo "Cannot find $inc"
    exit 1
  fi
  . $inc
done

# just testing?
if [ x$1 = x"--dryrun" ]; then
  echo=echo
  dryrun=$1
  shift
fi

DOCKERUSER=${DOCKERUSER:-gsatts}
DOCKERREPO=${DOCKERREPO:-usagov-2021}

APP_SPACE=${1:-please-provide-space-name-as-first-argument}
APP_SPACE=$(echo "$APP_SPACE" | tr '[:upper:]' '[:lower:]')
assertCurSpace $APP_SPACE
shift

APP_ORG=getOrg

export APP_NAME="cms"

CTAG=${1:-latest}
CDIGEST=${2:-}

EGRESS_SPACE='shared-egress'
#if [ "$APP_SPACE" == "dev-dr" ]; then
#    EGRESS_SPACE='shared-egress-dr'
#fi

function restartApp { #appname
  app=$1
  if [ -z "$app" ]; then
    echo "ERROR: appname is required"
    exit 1
  fi
  echo cf restart $app --no-wait --strategy rolling
  $echo cf restart $app --no-wait --strategy rolling
}

function pushApp { #appname
  app=$1
  if [ -z "$app" ]; then
    echo "ERROR: appname is required"
    exit 1
  fi

  instances="-i 1"
  if [ "$APP_SPACE" == "prod" ]; then
    instances="-i 2"
  elif [ "$APP_SPACE" == "stage" ]; then
    instances="-i 1"
  elif [ "$APP_SPACE" == "dev" ]; then
    instances="-i 1"
  fi

  if existsCFApp $app; then
    echo "App $app already exists - use normal cf routing"
    no_route=""
  else
    no_route="--no-route"
    echo "App $app does not exist - will push with --no-route to prevent failure on first push"
  fi

  # The Image digest for this tag should be looked up from cloud.gov storage
  # Any tag with a stored Image digest should be referenced by hash instead of tag
  if [ -z "$CDIGEST" ]; then
    echo "Deploying ${DOCKERUSER}/${DOCKERREPO}:${app}-${CTAG}"
    if [ -z "$DOCKERHUB_ACCESS_TOKEN" ]; then
      echo  cf push $app $instances $no_route --docker-image ${DOCKERUSER}/${DOCKERREPO}:${app}-${CTAG} --strategy rolling
      $echo cf push $app $instances $no_route --docker-image ${DOCKERUSER}/${DOCKERREPO}:${app}-${CTAG} --strategy rolling
      RETVAL=$?
    else
      export CF_DOCKER_PASSWORD=$DOCKERHUB_ACCESS_TOKEN
      echo  cf push $app $instances $no_route --docker-image ${DOCKERUSER}/${DOCKERREPO}:${app}-${CTAG} --docker-username $DOCKERHUB_USERNAME --strategy rolling
      $echo cf push $app $instances $no_route --docker-image ${DOCKERUSER}/${DOCKERREPO}:${app}-${CTAG} --docker-username $DOCKERHUB_USERNAME --strategy rolling
      RETVAL=$?
      unset CF_DOCKER_PASSWORD
    fi
  else
    echo "Deploying ${DOCKERUSER}/${DOCKERREPO} ${app}-${CTAG} via digest ${CDIGEST}"
    if [ -z "$DOCKERHUB_ACCESS_TOKEN" ]; then
      echo  cf push $app $instances $no_route --docker-image ${DOCKERUSER}/${DOCKERREPO}${CDIGEST} --strategy rolling
      $echo cf push $app $instances $no_route --docker-image ${DOCKERUSER}/${DOCKERREPO}${CDIGEST} --strategy rolling
      RETVAL=$?
    else
      export CF_DOCKER_PASSWORD=$DOCKERHUB_ACCESS_TOKEN
      echo  cf push $app $instances $no_route --docker-image ${DOCKERUSER}/${DOCKERREPO}${CDIGEST} --docker-username $DOCKERHUB_USERNAME --strategy rolling
      $echo cf push $app $instances $no_route --docker-image ${DOCKERUSER}/${DOCKERREPO}${CDIGEST} --docker-username $DOCKERHUB_USERNAME --strategy rolling
      RETVAL=$?
      unset CF_DOCKER_PASSWORD
    fi
  fi
  if [ $RETVAL -ne 0 ]; then
    echo "ERROR: cf push failed ($RETVAL)"
    exit $RETVAL
  fi
}

function setupRoutes { #appname
  app=$1
  if [ -z "$app" ]; then
    echo "ERROR: appname is required"
    exit 1
  fi

  createRoute apps.internal ${app}-$APP_SPACE-usagov
  mapRoute $app apps.internal ${app}-$APP_SPACE-usagov

  if [ "$APP_SPACE" == "prod" ]; then
     createRoute usa.gov $app
     mapRoute $app usa.gov $app
  else
    createRoute usa.gov ${app}-$APP_SPACE
    mapRoute $app usa.gov ${app}-$APP_SPACE
  fi
}

function setupEgress { #appname
  app=$1
  if [ -z "$app" ]; then
    echo "ERROR: appname is required"
    exit 1
  fi

  if [ x$echo != x ]; then
    echo DRYRUN=yes $SCRIPT_DIR/setup-egress-for-apps $app --no-restart
    DRYRUN=yes $SCRIPT_DIR/setup-egress-for-apps $app --no-restart
  else
    echo $SCRIPT_DIR/setup-egress-for-apps $app --no-restart
    $SCRIPT_DIR/setup-egress-for-apps $app --no-restart
    RETVAL=$?
    if [ $RETVAL -ne 0 ]; then
      echo "ERROR: setup-egress-for-apps failed ($RETVAL)"
      exit $RETVAL
    fi
  fi
}

function setUSPSCreds {
  app=$1
  cfSetEnv $app USPS_API_ENV $USPS_API_ENV
  cfSetEnv $app USPS_USERID $USPS_USERID
  cfSetEnv $app USPS_PASSWORD $USPS_PASSWORD
}

function setCallCenterEWTBucket {
  app=$1
  cfSetEnv $app CALL_CENTER_EWT_BUCKET $CALL_CENTER_EWT_BUCKET
}

if existsCFApp $APP_NAME; then
  setupRoutes $APP_NAME
  setupEgress $APP_NAME
  setUSPSCreds $APP_NAME
  setCallCenterEWTBucket $APP_NAME
  if existsCFService "cache-service"; then
      bindServiceToApp $APP_NAME cache-service
  fi
  if existsCFService "s3forAnalyticsReporter"; then
      bindServiceToApp $APP_NAME s3forAnalyticsReporter
  fi
  pushApp $APP_NAME
else
  cf set-env $APP_NAME SKIP_DRUPAL_BOOTSTRAP "skip" &> /dev/null ### redirect error message - we know app doesn't exist
  pushApp $APP_NAME
  setupRoutes $APP_NAME
  setupEgress $APP_NAME
  if existsCFService "cache-service"; then
      bindServiceToApp $APP_NAME cache-service
  fi
  if existsCFService "s3forAnalyticsReporter"; then
      bindServiceToApp $APP_NAME s3forAnalyticsReporter
  fi
  setUSPSCreds $APP_NAME
  setCallCenterEWTBucket $APP_NAME
  cfSetEnv $APP_NAME SKIP_DRUPAL_BOOTSTRAP ""
  restartApp $APP_NAME
fi
