#!/usr/bin/env bash
#
# Deploy services and app for cron app.  Service creation should be idempotent.
#

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# Optional includes: we might be running in circleci, or a local dev machine
for f in /home/circleci/project/env.local $SCRIPT_DIR/env.local ./env.local; do
  if [ -f $f ]; then
    . $f
  fi
done

# Mandatory includes:
for inc in $SCRIPT_DIR/../deploy/includes; do
  if [ ! -f $inc ]; then
    echo "Cannot find $inc"
    exit 1
  fi
  . $inc
done

# just testing?
if [ x$1 = x"--dryrun" ]; then
  echo=echo
  dryrun=$1
  shift
fi

DOCKERUSER=${DOCKERUSER:-gsatts}
DOCKERREPO=${DOCKERREPO:-usagov-2021}

APP_SPACE=${1:-please-provide-space-name-as-first-argument}
APP_SPACE=$(echo "$APP_SPACE" | tr '[:upper:]' '[:lower:]')
assertCurSpace $APP_SPACE
shift

APP_ORG=getOrg

export APP_NAME="cron"
export APP_INSTANCES=1

CTAG=${1:-latest}
CDIGEST=${2:-}

# The Image digest for this tag should be looked up from cloud.gov storage
# Any tag with a stored Image digest should be referenced by hash instead of tag
if [ -z "$CDIGEST" ]; then
  echo "AppSpec: ${DOCKERUSER}/${DOCKERREPO}:${APP_NAME}-${CTAG}"
  APPSPEC="${DOCKERUSER}/${DOCKERREPO}:${APP_NAME}-${CTAG}"
else
  echo "AppSpec: ${DOCKERUSER}/${DOCKERREPO}${CDIGEST}"
  APPSPEC="${DOCKERUSER}/${DOCKERREPO}${CDIGEST}"
fi

# launch the app
echo "Deploying ${DOCKERUSER}/${DOCKERREPO}:${APP_NAME}"
if existsCFService ${APP_NAME}-service-account; then
  echo "User service ${APP_NAME}-service-account already exists - good!"
else
  echo  $SCRIPT_DIR/create-service-account $APP_SPACE $APP_NAME
  $echo $SCRIPT_DIR/create-service-account $APP_SPACE $APP_NAME
  retval=$?
  if [ $retval -ne 0 ]; then
    echo "ERROR: '$SCRIPT_DIR/create-service-account $APP_SPACE $APP_NAME' failed ($retval)"
    exit $retval
  fi
fi

if existsCFService cfevent-service-account; then
  echo "User service cfevent-service-account already exists - good!"
else
  echo  $SCRIPT_DIR/create-service-account $APP_SPACE cfevent
  $echo $SCRIPT_DIR/create-service-account $APP_SPACE cfevent
  retval=$?
  if [ $retval -ne 0 ]; then
    echo "ERROR: '$SCRIPT_DIR/create-service-account $APP_SPACE cfevent' failed ($retval)"
    exit $retval
  fi
fi

if existsCFService callcenter-service-account; then
  echo "User service callcenter-service-account already exists - good!"
else
  echo  $SCRIPT_DIR/create-service-account $APP_SPACE callcenter
  $echo $SCRIPT_DIR/create-service-account $APP_SPACE callcenter
  retval=$?
  if [ $retval -ne 0 ]; then
    echo "ERROR: '$SCRIPT_DIR/create-service-account $APP_SPACE callcenter' failed ($retval)"
    exit $retval
  fi
fi

STATE_STORAGE_SERVICE=${APP_NAME}-state-storage
EVENT_STORAGE_SERVICE=${APP_NAME}-event-storage
CALLWAIT_STORAGE_SERVICE=${APP_NAME}-callwait-storage
for storage_service in $STATE_STORAGE_SERVICE $EVENT_STORAGE_SERVICE $CALLWAIT_STORAGE_SERVICE; do
  echo "Configuring $storage_service"
  if existsCFService $storage_service &> /dev/null; then
    echo "$storage_service already created - good!"
  else
    if [ $storage_service = $CALLWAIT_STORAGE_SERVICE ]; then
      echo  cf create-service s3 basic-public $storage_service
      $echo cf create-service s3 basic-public $storage_service
      retval=$?
      if [ $retval -eq 0 ]; then
        source bin/cloudgov/get-s3-access $storage_service
        echo  aws s3api put-bucket-cors --bucket $S3_BUCKET --cors-configuration file://bin/cloudgov/s3-cors-policy-usagov-sites-and-localhost.json
        $echo aws s3api put-bucket-cors --bucket $S3_BUCKET --cors-configuration file://bin/cloudgov/s3-cors-policy-usagov-sites-and-localhost.json
        retval=$?
        if [ $retval -ne 0 ]; then
          echo "ERROR: 'aws s3api put-bucket-cors ...' failed ($retval)"
          exit $retval
        fi
      else
        echo "ERROR: 'cf create-service s3 basic-public $storage_service' failed ($retval)"
        exit $retval
      fi
    else
      echo  cf create-service s3 basic $storage_service
      $echo cf create-service s3 basic $storage_service
      retval=$?
      if [ $retval -ne 0 ]; then
        echo "ERROR: 'cf create-service s3 basic $storage_service' failed ($retval)"
        exit $retval
      fi
    fi
    if existsCFService $storage_service &> /dev/null; then
      echo "$storage_service successfully created"
    else
      echo "ERROR: $storage_service creation failed"
      exit 1
    fi
  fi
done

function cf_push {
  appspec=$1
  instances=${2:-1} ### Always spawn a single app instance unless told otherwise
  if [ -z "$DOCKERHUB_ACCESS_TOKEN" ]; then
    echo  cf push ${APP_NAME} --docker-image ${appspec} --strategy rolling
    $echo cf push ${APP_NAME} --docker-image ${appspec} --strategy rolling
    retval=$?
    if [ $retval -ne 0 ]; then
      echo "ERROR: 'cf push ${APP_NAME} --docker-image ${appspec} --strategy rolling' failed ($retval)"
      exit $retval
    fi
  else
    export CF_DOCKER_PASSWORD=$DOCKERHUB_ACCESS_TOKEN
    echo  cf push ${APP_NAME} --docker-image ${appspec} --docker-username $DOCKERHUB_USERNAME --strategy rolling
    $echo cf push ${APP_NAME} --docker-image ${appspec} --docker-username $DOCKERHUB_USERNAME --strategy rolling
    retval=$?
    unset CF_DOCKER_PASSWORD
    if [ $retval -ne 0 ]; then
      echo "ERROR: 'cf push ${APP_NAME} --docker-image ${appspec} --docker-username $DOCKERHUB_USERNAME --strategy rolling' failed ($retval)"
      exit $retval
    fi
  fi
  }

if existsCFApp ${APP_NAME} ; then
  $SCRIPT_DIR/setup-egress-for-apps ${APP_NAME} --no-restart
  retval=$?
  if [ $retval != 0 ]; then
    echo "ERROR: '$SCRIPT_DIR/setup-egress-for-apps ${APP_NAME} --no-restart' has failed.  Check output stream!"
    exit 1
  fi
  cf_push $APPSPEC $APP_INSTANCES
  retval=$?
  if [ $retval != 0 ]; then ## Should retval be set above here?
    echo "ERROR: 'cf_push $APPSPEC $APP_INSTANCES' has failed.  Check output stream!"
    exit 1
  fi
else
  cf_push $APPSPEC $APP_INSTANCES
  retval=$?
  if [ $retval != 0 ]; then ## Should retval be set above here?
    echo "ERROR: 'cf_push $APPSPEC $APP_INSTANCES' has failed.  Check output stream!"
    exit 1
  fi

  echo  $SCRIPT_DIR/setup-egress-for-apps ${APP_NAME} --no-restart
  $echo $SCRIPT_DIR/setup-egress-for-apps ${APP_NAME} --no-restart
  retval=$?
  if [ $retval != 0 ]; then ## Should retval be set above here?
    echo "ERROR: setup-egress-for-apps has failed.  Check output stream!"
    exit 1
  fi
fi

### Setting up network policy so that cron app can talk to cms directly
echo  cf add-network-policy cron cms --protocol tcp --port 80
$echo cf add-network-policy cron cms --protocol tcp --port 80
retval=$?
if [ $retval != 0 ]; then
  echo "ERROR: cf add-network-policy cron cms --protocol tcp --port 80 has failed ($retval).  Check output stream!"
  exit 1
fi

### These are set for some reason - unset them at deployment
cfUnSetEnv $APP_NAME HTTP_PROXY
cfUnSetEnv $APP_NAME HTTPS_PROXY
cfUnSetEnv $APP_NAME http_proxy
cfUnSetEnv $APP_NAME https_proxy

### Call center env (should we move this to a user-provided credentials service?)
cfSetEnv $APP_NAME CALL_CENTER_CLIENT_ID $CALL_CENTER_CLIENT_ID
cfSetEnv $APP_NAME CALL_CENTER_CLIENT_SECRET $CALL_CENTER_CLIENT_SECRET
cfSetEnv $APP_NAME CALL_CENTER_ENVIRONMENT $CALL_CENTER_ENVIRONMENT
cfSetEnv $APP_NAME CALL_CENTER_EN_QUEUE_ID $CALL_CENTER_EN_QUEUE_ID
cfSetEnv $APP_NAME CALL_CENTER_SP_QUEUE_ID $CALL_CENTER_SP_QUEUE_ID

### Syncing lightweight cron key
echo "Updating lightweight cron key"
if existsCFService "secrets" ; then
  echo "secrets already created: updating"
  SECRETS=$(cf curl /v3/service_instances/$(cf service secrets --guid)/credentials)
  CRON_KEY=$(echo $SECRETS | jq -r '.CRON_KEY')
  if [ -z "$CRON_KEY" ] || [ "$CRON_KEY" = "null" ]; then
    echo "ERROR: cannot find CRON_KEY in secrets service"
    exit 1
  fi

  retval=0
  if existsCFService "cron-secrets" ; then
    if [ x$echo = x ]; then
      echo "create-user-provided-service cron-secrets -p " "{\"CRON_KEY\": \"$CRON_KEY\"}"
      yes '' | cf update-user-provided-service cron-secrets -p "{\"CRON_KEY\": \"$CRON_KEY\"}"
      retval=$?
    else
      echo "create-user-provided-service cron-secrets -p " "{\"CRON_KEY\": \"$CRON_KEY\"}"
    fi
  else
    echo  cf create-user-provided-service cron-secrets -p "{\"CRON_KEY\": \"$CRON_KEY\"}"
    $echo cf create-user-provided-service cron-secrets -p "{\"CRON_KEY\": \"$CRON_KEY\"}"
    retval=$?
  fi
  if [ $retval != 0 ]; then
    echo "ERROR: cannot create or update cron-secrets service: ($retval)"
    exit 1
  fi
fi

# Enable call center / cfevents  scripts on prod only. (We can manually update this in dev, etc. for testing)
if [ $APP_SPACE = "prod" ]; then
    cfSetEnv $APP_NAME CALL_CENTER_RUN "true"
    cfSetEnv $APP_NAME CFEVENT_RUN "true"
fi

echo  cf restage $APP_NAME --strategy rolling
$echo cf restage $APP_NAME --strategy rolling
