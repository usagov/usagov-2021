#!/bin/sh

# List database backup snapshots
# Usage: db-snapshot-list <space> [--with-dates] [--include-auto]
#   --with-dates    Show last modified dates
#   --include-auto  Include automatic backups (in addition to manual snapshots)

# we might be running in circleci
if [ -f /home/circleci/project/env.local ]; then
  . /home/circleci/project/env.local
fi
# we might be running from a local dev machine
SCRIPT_DIR="$(dirname "$0")"
if [ -f $SCRIPT_DIR/env.local ]; then
  . $SCRIPT_DIR/env.local
fi
if [ -f ./env.local ]; then
  . ./env.local
fi
if [ -f $SCRIPT_DIR/../deploy/includes ]; then
  . $SCRIPT_DIR/../deploy/includes
else
   echo Cannot find $SCRIPT_DIR/../deploy/includes
   exit 1
fi

# just testing?
if [ x$1 = x"--dryrun" ]; then
  export echo=echo
  shift
fi

SPACE=${1:-please-provide-space-name-as-first-argument}
SPACE=$(echo "$SPACE" | tr '[:upper:]' '[:lower:]')
assertCurSpace $SPACE
shift

if [ x$echo = xecho ]; then
  echo "Existing Database Tags ... (dry run - no tags will be collected)"
   exit
fi

printf "Existing Database Tags ..."

WITH_DATES="0"
INCLUDE_AUTO="0"
SORT_METHOD="sort"

# Parse arguments
while [ $# -gt 0 ]; do
  case "$1" in
    --with-dates)
      WITH_DATES="1"
      SORT_METHOD="sort -rn -k1"
      shift
      ;;
    --include-auto)
      INCLUDE_AUTO="1"
      shift
      ;;
    *)
      shift
      ;;
  esac
done

# locate database backups within s3 bucket
# display a list of available tags and their last updated date

source bin/cloudgov/get-s3-access storage >/dev/null 2>&1

# Get manual database backups from db-backup/ folder
export available_tags=$(aws s3 ls s3://$S3_BUCKET/db-backup/ | awk '{print $NF}' | sed 's/[\/ ]*$//g')

# Optionally include auto backups from database/ folder
if [ "$INCLUDE_AUTO" == "1" ]; then
  export auto_tags=$(aws s3 ls s3://$S3_BUCKET/database/ 2>/dev/null | awk '{print $NF}' | sed 's/[\/ ]*$//g')
  if [ -n "$auto_tags" ]; then
    available_tags=$(echo -e "$available_tags\n$auto_tags" | grep -v "^$")
  fi
fi
# printf "\r                             \r"
if [ "$WITH_DATES" == "1" ]; then
  # sort by date, most recent first
  echo
  for tag in $(echo $available_tags); do
    # gather the most recently update file under the path-tag
    # there are >1k files so make sure we push the sort/extract logic into the server side query

    # Check if this is an auto backup (contains DB-AUTO- prefix)
    if echo "$tag" | grep -q "^DB-AUTO-"; then
      # Auto backup - check database/ path (files are stored directly, not in folders)
      export last_updated=$(aws s3api list-objects-v2 --bucket $S3_BUCKET --prefix database/$tag --query 'sort_by(Contents, &LastModified)[-1].LastModified' 2>/dev/null | sed 's/"//g')
      if [ "$last_updated" != "null" ] && [ -n "$last_updated" ]; then
        JUST_THE_TAG=$(basename $tag .sql.gz)
        echo "$last_updated $JUST_THE_TAG ($tag) (auto)"
      fi
    else
      # Manual backup - check db-backup/ path
      export last_updated=$(aws s3api list-objects-v2 --bucket $S3_BUCKET --prefix db-backup/$tag/ --query 'sort_by(Contents, &LastModified)[-1].LastModified' 2>/dev/null | sed 's/"//g')
      if [ "$last_updated" != "null" ] && [ -n "$last_updated" ]; then
        JUST_THE_TAG=$(basename $tag .sql.gz)
        echo "$last_updated $JUST_THE_TAG ($tag)"
      fi
    fi
  done | sort -rn -k1
else
  # default to alphabetical sorting by tag name
  echo
  if [ "$INCLUDE_AUTO" == "1" ]; then
    echo "$available_tags" | sed 's/\.sql\.gz//g' | sort | sed 's/^DB-AUTO-/DB-AUTO- (auto) /'
  else
    echo "$available_tags" | sed 's/\.sql\.gz//g' | sort
  fi
fi
