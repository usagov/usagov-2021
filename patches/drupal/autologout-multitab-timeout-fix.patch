+       * schedule the inactivity timer, so it reflects activity in any tab.
+       */
+      function logRemainingTime() {
+        if (!window.console || typeof window.console.info !== 'function') {
+          return;
+        }
+        const remaining = localSettings.timeout - (Date.now() - getLastActive());
