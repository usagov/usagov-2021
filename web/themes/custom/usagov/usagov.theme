<?php

use Drupal\Core\Url;
use Drupal\node\Entity\Node;
use Drupal\taxonomy\Entity\Term;
use Drupal\usa_twig_vars\TaxonomyDatalayerBuilder;

/**
 * @file
 * USWDS Base sub-theme.
 *
 * Place your custom PHP code in this file.
 *
 * @param array<string, mixed> $variables
 */

function usagov_preprocess_html(array &$variables): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  $variables['node'] = $node;

  $variables['usagov_affiliate'] = \Drupal::state()->get('usagov_affiliate', 'usagov_en_all_gov');
  $variables['usagov_affiliate_es'] = \Drupal::state()->get('usagov_affiliate_es', 'usagov_es_internal');

  // Set a reliable language variable for the template
  // This ensures proper language detection even when there's no node context (like in views)
  $current_language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $variables['language'] = $current_language;
}

/**
 * Builds the pager's numeric range to match Benefit Search pagination.
 */
function usagov_preprocess_pager(array &$variables): void {
  $element = $variables['pager']['#element'];
  $parameters = $variables['pager']['#parameters'];
  $route_name = $variables['pager']['#route_name'];
  $route_parameters = $variables['pager']['#route_parameters'] ?? [];
  $pager_manager = \Drupal::service('pager.manager');
  $pager = $pager_manager->getPager($element);
  if (!$pager) {
    return;
  }

  $last_page_number = $pager->getTotalPages();
  $current_page_number = $pager->getCurrentPage() + 1;
  $variables['last_page_number'] = $last_page_number;
  $variables['usagov_pager_pages'] = [];

  if ($last_page_number <= 1) {
    return;
  }

  if ($last_page_number <= 7) {
    $items = range(1, $last_page_number);
  }
  elseif ($current_page_number <= 4) {
    $items = array_merge(range(1, 5), ['ellipsis'], [$last_page_number]);
  }
  elseif ($current_page_number >= $last_page_number - 3) {
    $items = array_merge([1], ['ellipsis'], range($last_page_number - 4, $last_page_number));
  }
  else {
    $items = [
      1,
      'ellipsis',
      $current_page_number - 1,
      $current_page_number,
      $current_page_number + 1,
      'ellipsis',
      $last_page_number,
    ];
  }

  foreach ($items as $item) {
    if ($item === 'ellipsis') {
      $variables['usagov_pager_pages'][] = ['type' => 'ellipsis'];
      continue;
    }

    $variables['usagov_pager_pages'][] = [
      'type' => 'page',
      'number' => $item,
      'href' => Url::fromRoute($route_name, $route_parameters, [
        'query' => $pager_manager->getUpdatedParameters($parameters, $element, $item - 1),
      ])->toString(),
      'current' => $item === $current_page_number,
      'is_last' => $item === $last_page_number,
    ];
  }
}

/**
 * children_of_active_menu_item is a recursive helper function for finding the
 * children of the active menu item
 *
 * @param array<string, array<string, mixed>> $items
 *   Array of menu children
 */
function children_of_active_menu_item(array &$items): mixed {
  $result = NULL;
  foreach ($items as $object) {
    if ($object['in_active_trail'] === TRUE) {
      $result = $object;
      break;
    }
  }
  if ($result === NULL) {
    return $items;
  }
  else {
    return children_of_active_menu_item($result['below']);
  }
}

/**
 * Process paragraph content
 *
 * @param array<string, mixed> $variables
 */
function usagov_preprocess_paragraph(array &$variables): void {
  /**
   * Pass node value to pages so they can access node-based properties
   */
  $node = \Drupal::routeMatch()->getParameter('node');
  $variables['node'] = $node;

  /**
   * Pass alert status label translations to uswds-alert paragraph templates.
   * Centralised here so paragraph--uswds-alert.html.twig and its variants
   * don't each need to duplicate the language check.
   */
  if (in_array($variables['paragraph']->bundle(), ['uswds_alert'])) {
    $langcode = $node ? $node->language()->getId() : \Drupal::languageManager()->getCurrentLanguage()->getId();
    $variables['alert_translations'] = $langcode === 'es'
      ? ['info' => 'información', 'warning' => 'aviso', 'error' => 'error', 'success' => 'exito']
      : ['info' => 'Information', 'warning' => 'Warning', 'error' => 'Error', 'success' => 'Success'];
  }
}

/**
 * Process block content
 *
 * @param array<string, mixed> $variables
 */
function usagov_preprocess_block(array &$variables): void {
  /*
   * Pass node value to pages so they can access node-based properties
   */
  $node = \Drupal::routeMatch()->getParameter('node');
  $variables['node'] = $node;

  /*
   * Pass pagetype to pages so they can know what type of page to render
   */
  if ($node && $node->hasField('field_page_type') && $node->get('field_page_type')[0]->target_id) {
    $pagetypeTid = $node->get('field_page_type')[0]->target_id;
    $variables['pagetype'] = Term::load($pagetypeTid)->getName();
  }

  /*
   * Pass menu data to nav pages so they can render links to their children
   */
  if ($variables['elements']['#id'] == 'navigation_page_items' || $variables['elements']['#id'] == 'navigation_page_items_spanish') {
    // Use url.query_args as well for an easier test case.
    $added_contexts = ['url.path'];
    $variables['content']['#cache']['contexts'] = array_merge($variables['content']['#cache']['contexts'], $added_contexts);
    $variables['#cache']['contexts'] = array_merge($variables['#cache']['contexts'], $added_contexts);
    $items = $variables['content']['#items'];
    $children_of_active_menu_item = children_of_active_menu_item($items);
    $nav_page_items = [];
    foreach ($children_of_active_menu_item as $child) {
      $data = new StdClass();
      // Get title, description and url if available.
      try {
        if (isset($child['url']->getRouteParameters()['node'])) {
          $childNid = $child['url']->getRouteParameters()['node'];
          $childNode = Node::load($childNid);
          $data->title = $childNode->get('title')->value;
          $data->url = $childNode->toUrl()->toString();
        }
        elseif (isset($child['original_link']->getPluginDefinition()['route_parameters']['taxonomy_term'])) {
          $data->url = $child['url'];
          $data->title = $child['title'];
          $data->description = $child['original_link']->getPluginDefinition()['description'];
        }
        else {
          // For all other routes (views, custom routes, etc.), use menu item data
          $data->title = $child['title'];
          $data->url = $child['url']->toString();
        }
      }
      catch (Exception $e) {
        $menuItem = $child['original_link']->getPluginDefinition();
        $data->title = $menuItem['title'];

        $data->url = $menuItem['url'];
        if (strncmp($data->url, "base:", 5) === 0) {
          $data->url = "/" . substr($data->url, 5);
        }
      }

      /* Get Description (Optional Field - A catch on this shouldn't
      trigger a catch on title or url). */
      try {
        // First, check if the menu item has a nav card content override
        if (isset($child['original_link'])) {
          $menu_link_entity = \Drupal::entityTypeManager()
            ->getStorage('menu_link_content')
            ->loadByProperties(['uuid' => $child['original_link']->getDerivativeId()]);

          if ($menu_link_entity) {
            $menu_link = reset($menu_link_entity);
            if ($menu_link && $menu_link->hasField('field_nav_card_override')) {
              $override_value = $menu_link->get('field_nav_card_override')->value;
              if (!empty($override_value)) {
                $data->description = $override_value;
              }
            }
          }
        }

        // If no override, fall back to the node fields
        if (!isset($data->description) && isset($child['url']->getRouteParameters()['node'])) {
          $childNid = $child['url']->getRouteParameters()['node'];
          $childNode = Node::load($childNid);
          if ($childNode->hasField('field_short_description') && $childNode->get('field_short_description')->value != "") {
            $data->description = $childNode->get('field_short_description')->value;
          }
          elseif ($childNode->hasField('field_page_intro') && $childNode->get('field_page_intro')->value != "") {
            $data->description = $childNode->get('field_page_intro')->value;
          }
          else {
            $data->description = $childNode->get('field_meta_description')->value;
          }
        }
      }
      catch (Exception $e) {
        // If we still don't have a description, try the menu item description
        if (!isset($data->description)) {
          $menuItem = $child['original_link']->getPluginDefinition();
          $data->description = $menuItem['description'];
        }
      }

      // Try for other fields.
      try {
        if (isset($child['url']->getRouteParameters()['node'])) {
          $childNid = $child['url']->getRouteParameters()['node'];
          $childNode = Node::load($childNid);
          if (
            $childNode->hasField('field_navigation_banner_image') &&
            count($childNode->get('field_navigation_banner_image')) &&
            $childNode->get('field_navigation_banner_image')[0]->entity
          ) {
            // To allow for image_style (webp compression) to apply.
            $banner_uri = $childNode->get('field_navigation_banner_image')[0]->entity->get('field_media_image')->entity->getFileUri();
            $data->navigation_banner_image = $banner_uri;
          }
          if ($childNode->hasField('field_css_icon') && count($childNode->get('field_css_icon'))) {
            $data->css_icon = $childNode->get('field_css_icon')[0]->value;
          }
          if ($childNode->hasField('promote')) {
            $data->promote = $childNode->get('promote')->value;
          }
        }
      }
      catch (Exception $e) {
      }

      array_push($nav_page_items, $data);
    }
    $variables['nav_page_items'] = $nav_page_items;
  }
}

/**
 * HOOK_preprocess_views_view_list
 *
 * @param array<string, mixed> $variables
 */
function usagov_preprocess_views_view_list(array &$variables): void {
  $variables['node'] = \Drupal::routeMatch()->getParameter('node');
}

/**
 * HOOK_theme_suggestions_alter
 *
 * @param array<string> $suggestions
 * @param array<string, mixed> $variables
 */
function usagov_theme_suggestions_alter(array &$suggestions, array $variables, string $hook): void {
  if ($hook == 'menu' && isset($variables['menu_name']) && $variables['menu_name'] === 'usagov_blog_menu') {
    // Ensure the blog menu always uses our custom template, regardless of
    // what other modules/themes add to the suggestions list.
    $suggestions[] = 'menu__usagov_blog_menu';
  }

  if ($hook == 'views_view_fields') {
    $id = $variables['view']->storage->id();
    if ($id == "sub_children") {
      $suggestions[] = 'views_view_fields__sub_children';
    }
  }
  if ($hook == 'views_view_field') {
    $id = $variables['view']->storage->id();
    if ($id == "sub_children") {
      $suggestions[] = 'views_view_field__sub_children';
    }
  }
  if ($hook == 'views_view') {
    $id = $variables['view']->storage->id();
    if ($id == "sub_children") {
      $suggestions[] = 'views_view__sub_children';
    }
  }
  if ($hook == 'views_view_list') {
    $id = $variables['view']->storage->id();
    if ($id == "sub_children") {
      $suggestions[] = 'views_view_list__sub_children';
    }
  }
  if ($hook == 'field') {
    if (in_array('field__node__field_custom_twig_content', $suggestions) &&
      $variables['element']['#object']->field_custom_twig_content->value) {
      $current_path = \Drupal::service('path.current')->getPath();
      $current_alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
      $no_slash = ltrim($current_alias, '/');
      $no_dash = str_replace('-', '_', $no_slash);
      $suggestions[] = 'field__node__field_custom_twig_content_' . $no_dash;
    }
  }
}

/**
 * @param array<string, mixed> $variables
 */
function usagov_preprocess_breadcrumb(&$variables): void {

  // Translate Spanish homepage label
  array_walk($variables['breadcrumb'], function (array &$crumb): void {
    if ($crumb['url'] === '/es') {
      $crumb['text'] = TaxonomyDatalayerBuilder::HOME_TITLE_ES;
    }
  });

  $node = \Drupal::routeMatch()->getParameter('node');
  if (empty($node)) {
    return;
  }

  $currentTitle = Drupal::service('title_resolver')->getTitle(
    \Drupal::request(),
    \Drupal::routeMatch()->getRouteObject()
  );

  if (str_starts_with($node->toUrl()->toString(), '/agencies/')) {
    $variables['breadcrumb'] = [];
    $variables['breadcrumb'][] = [
      'text' => TaxonomyDatalayerBuilder::HOME_TITLE_EN,
      'url' => TaxonomyDatalayerBuilder::HOME_URL_EN
    ];
    $variables['breadcrumb'][] = [
      'text' => TaxonomyDatalayerBuilder::aboutGovtEn(),
      'url' => TaxonomyDatalayerBuilder::aboutUrlEn()
    ];
    $variables['breadcrumb'][] = [
      'text' => TaxonomyDatalayerBuilder::agencyIndexEn(),
      'url' => TaxonomyDatalayerBuilder::agencyIndexUrlEn()
    ];
    $variables['breadcrumb'][] = ['text' => $currentTitle];
  }

  if (str_starts_with($node->toUrl()->toString(), '/states/')) {
    $variables['breadcrumb'] = [];
    $variables['breadcrumb'][] = [
      'text' => TaxonomyDatalayerBuilder::HOME_TITLE_EN,
      'url' => TaxonomyDatalayerBuilder::HOME_URL_EN
    ];
    $variables['breadcrumb'][] = [
      'text' => TaxonomyDatalayerBuilder::aboutGovtEn(),
      'url' => TaxonomyDatalayerBuilder::aboutUrlEn()
    ];
    $variables['breadcrumb'][] = [
      'text' => TaxonomyDatalayerBuilder::stateIndexEn(),
      'url' => TaxonomyDatalayerBuilder::stateIndexUrlEn()
    ];
    $variables['breadcrumb'][] = ['text' => $currentTitle];
  }

  if (str_starts_with($node->toUrl()->toString(), '/es/agencias/')) {
    $variables['breadcrumb'] = [];
    $variables['breadcrumb'][] = [
      'text' => TaxonomyDatalayerBuilder::HOME_TITLE_ES,
      'url' => TaxonomyDatalayerBuilder::HOME_URL_ES,
    ];
    $variables['breadcrumb'][] = [
      'text' => TaxonomyDatalayerBuilder::aboutGovtEs(),
      'url' => TaxonomyDatalayerBuilder::aboutUrlEs()
    ];
    $variables['breadcrumb'][] = [
      'text' => TaxonomyDatalayerBuilder::agencyIndexEs(),
      'url' => TaxonomyDatalayerBuilder::agencyIndexUrlEs()
    ];
    $variables['breadcrumb'][] = ['text' => $currentTitle];
  }

  if (str_starts_with($node->toUrl()->toString(), '/es/estados/')) {
    $variables['breadcrumb'] = [];
    $variables['breadcrumb'][] = [
      'text' => TaxonomyDatalayerBuilder::HOME_TITLE_ES,
      'url' => TaxonomyDatalayerBuilder::HOME_URL_ES
    ];
    $variables['breadcrumb'][] = [
      'text' => TaxonomyDatalayerBuilder::aboutGovtEs(),
      'url' => TaxonomyDatalayerBuilder::aboutUrlEs()
    ];
    $variables['breadcrumb'][] = [
      'text' => TaxonomyDatalayerBuilder::stateIndexEs(),
      'url' => TaxonomyDatalayerBuilder::stateIndexUrlEs()
    ];
    $variables['breadcrumb'][] = ['text' => $currentTitle];
  }
}

function usagov_preprocess_block__mobile_navigation(array &$variables) {
  $variables['usagov_affiliate'] = \Drupal::state()->get('usagov_affiliate', 'usagov_en_all_gov');
  $variables['usagov_affiliate_es'] = \Drupal::state()->get('usagov_affiliate_es', 'usagov_es_internal');
}

function usagov_preprocess_page_title(array &$variables): void {
  // Make node available in page-title template
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node) {
    $variables['node'] = $node;
  }
}

function usagov_preprocess_page(array &$variables): void {
  $affiliate = \Drupal::state()->get('usagov_affiliate', 'usagov_en_all_gov');
  $affiliate_es = \Drupal::state()->get('usagov_affiliate_es', 'usagov_es_internal');

  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $variables['usagov_affiliate_lang'] = $langcode == 'es' ? $affiliate_es : $affiliate;

  // Add variables for blog detection
  $route_match = \Drupal::routeMatch();
  $route_name = $route_match->getRouteName();
  $current_path = \Drupal::service('path.current')->getPath();
  $current_alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);

  // Check if we're on the blog_menu view (multiple ways to detect)
  $variables['is_blog_view'] = FALSE;
  $variables['blog_intro_heading'] = NULL;
  $variables['blog_intro_body'] = NULL;
  if ($route_name === 'view.blog_menu.page_1' ||
      $route_name === 'view.blog_menu.default' ||
      $current_path === '/blog' ||
      $current_alias === '/blog' ||
      strpos($route_name, 'blog_menu') !== FALSE) {
    $variables['is_blog_view'] = TRUE;
  }

  // content_type variable is already set in the template, but let's ensure it's available
  $node = $route_match->getParameter('node');
  if ($node && method_exists($node, 'bundle')) {
    $variables['content_type'] = $node->bundle();
  }

  if ($variables['is_blog_view'] || (($variables['content_type'] ?? '') === 'blog_post')) {
    $config_pages = \Drupal::entityTypeManager()
      ->getStorage('config_pages')
      ->loadByProperties(['type' => 'blog_intro']);

    if (!empty($config_pages)) {
      $blog_intro = reset($config_pages);
      if ($blog_intro->hasField('field_blog_intro_heading')) {
        $variables['blog_intro_heading'] = $blog_intro->get('field_blog_intro_heading')->value ?: NULL;
      }
      if ($blog_intro->hasField('field_blog_intro_body') && !$blog_intro->get('field_blog_intro_body')->isEmpty()) {
        $variables['blog_intro_body'] = \Drupal::entityTypeManager()
          ->getViewBuilder('config_pages')
          ->viewField($blog_intro->get('field_blog_intro_body'), [
            'label' => 'hidden',
          ]);
      }
    }
  }

  // Alternative method: check if the page contains blog-related content
  if (!$variables['is_blog_view']) {
    // Check if we're viewing a page that renders the blog view
    $view_storage = \Drupal::entityTypeManager()->getStorage('view');
    if ($view_storage->load('blog_menu')) {
      // Additional detection logic could go here if needed
    }
  }
}
