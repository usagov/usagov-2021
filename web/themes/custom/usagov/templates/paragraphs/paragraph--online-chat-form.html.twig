{% set chatID = elements.field_chat_id|field_value %}

<div id="liveagent_button_online_{{ chatID }}">
  {{ elements.field_chat_online }}
  <button id="chat-button"
          href="javascript://Chat"
          onclick="liveagent.startChat('{{ chatID }}')"
          class="usa-button"
    >{{ elements.field_chat_button|field_value }}
  </button><br />
  <br />
  &nbsp;
  {{ elements.field_chat_online_footer }}
</div>

<div id="liveagent_button_offline_{{ chatID }}"><!-- Offline Chat Content -->
  <header>
    {{ elements.field_chat_offline }}
  </header>
</div>
