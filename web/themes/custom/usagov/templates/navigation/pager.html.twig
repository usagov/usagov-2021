{#
/**
 * @file
 * Theme override for full pagers.
 *
 * Uses the same USWDS pagination classes as the Benefit Search pager.
 *
 * @see template_preprocess_pager()
 */
#}
{% if items and usagov_pager_pages|default([]) is not empty %}
  <nav role="navigation" aria-labelledby="{{ heading_id }}" class="usa-pagination" aria-label="{{ 'Pagination Navigation'|t }}">
    <{{ pagination_heading_level }} id="{{ heading_id }}" class="usa-sr-only">{{ 'Pagination'|t }}</{{ pagination_heading_level }}>
    <ul class="usa-pagination__list">
      {% if items.previous %}
        <li class="usa-pagination__item usa-pagination__arrow">
          <a href="{{ items.previous.href }}"
             class="usa-pagination__link usa-pagination__previous-page"
             title="{{ 'Go to previous page'|t }}"
             rel="prev"{{ items.previous.attributes|without('href', 'title', 'rel') }}
             aria-label="{{ 'Previous page'|t }}">
            <svg class="usa-icon" aria-hidden="true" focusable="false">
              <use xlink:href="/themes/custom/usagov/assets/img/sprite.svg#navigate_before"></use>
            </svg>
            <span class="usa-pagination__link-text">{{ 'Previous'|t }}</span>
          </a>
        </li>
      {% endif %}

      {% for item in usagov_pager_pages %}
        {% if item.type == 'ellipsis' %}
          <li class="usa-pagination__item usa-pagination__overflow" role="presentation">
            <span>&hellip;</span>
          </li>
        {% else %}
          <li class="usa-pagination__item usa-pagination__page-no">
            <a href="{{ item.href }}"
               class="usa-pagination__button{{ item.current ? ' usa-current' }}"
               aria-label="{% if item.is_last %}{{ 'Last page, page'|t }} {% else %}{{ 'Page'|t }} {% endif %}{{ item.number }}"
               {% if item.current %}aria-current="page"{% endif %}>
              {{ item.number }}
            </a>
          </li>
        {% endif %}
      {% endfor %}

      {% if items.next %}
        <li class="usa-pagination__item usa-pagination__arrow">
          <a href="{{ items.next.href }}"
             class="usa-pagination__link usa-pagination__next-page"
             title="{{ 'Go to next page'|t }}"
             rel="next"{{ items.next.attributes|without('href', 'title', 'rel') }}
             aria-label="{{ 'Next page'|t }}">
            <span class="usa-pagination__link-text">{{ 'Next'|t }}</span>
            <svg class="usa-icon" aria-hidden="true" focusable="false">
              <use xlink:href="/themes/custom/usagov/assets/img/sprite.svg#navigate_next"></use>
            </svg>
          </a>
        </li>
      {% endif %}
    </ul>
  </nav>
{% endif %}
