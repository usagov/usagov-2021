<div class="usa-prose">
  <p>
    Download the VA Form 21P-530EZ. Fill it out completely, sign it, and save it as a PDF.
  </p>
  <div>
    <a
      id="download-button"
      class="usa-button usa-button--secondary usa-button--big"
      type="button"
      href="./s3/files/2024-11/va-21p-530ez.pdf"
    >
      Download form 21P-530EZ
    </a>
  </div>

  <div
    id="error-box"
    class="usa-alert usa-alert--slim usa-alert--error usa-error--alert"
    tabindex="-1">
    <div class="usa-alert__body">
      <h3 class="usa-alert__heading">Your information contains errors</h3>
      <ul id="testing">
        <li id="error-street" class="usa-alert__text">
          <a href="#input-street"><span>Fill out the street field</span></a>
        </li>
        <li id="error-city" class="usa-alert__text">
          <a href="#input-city"><span>Fill out the city field</span></a>
        </li>
        <li id="error-state" class="usa-alert__text">
          <a href="#input-state"><span>Fill out the state field</span></a>
        </li>
        <li id="error-zip" class="usa-alert__text">
          <a href="#input-zip"><span>Fill out the ZIP code field</span></a>
        </li>
      </ul>
    </div>
  </div>

  <form
    class="usa-form maxw-none margin-y-4"
    action="/va-benefits-intake-results#skip-to-h1"
    autocomplete="off"
    name="VABenefitsIntakeForm"
    id="VABenefitsIntakeForm"
  >
    <div class="padding-1px bg-gray-5">
      <div class="maxw-mobile margin-x-auto margin-y-4">
        <p>
          <strong>All fields are required.</strong>
        </p>
        <div id="error-border">
          
          <div>
            <label id="veteransFirstName" class="usa-label" for="input-veterans-first-name">
            Veteran's First Name
            </label>
            <span id="veterans-first-name" class="errors"></span>
            <input
              class="usa-input"
              id="input-veterans-first-name"
              aria-describedby="veterans-first-name"
              name="input-veterans-first-name"
              type="text"
              onkeypress="return event.keyCode != 13;"
              required
              oninvalid="this.setCustomValidity('Fill out the Veteran's First Name field.')"
              oninput="this.setCustomValidity('')" />
          </div>

          <div>
            <label id="veteransLastName" class="usa-label" for="input-veterans-last-name">
            Veteran's Last Name
            </label>
            <span id="veterans-last-name" class="errors"></span>
            <input
              class="usa-input"
              id="input-veterans-last-name"
              aria-describedby="veterans-last-name"
              name="input-veterans-last-name"
              type="text"
              onkeypress="return event.keyCode != 13;"
              required
              oninvalid="this.setCustomValidity('Fill out the Veteran's Last Name field.')"
              oninput="this.setCustomValidity('')" />
          </div>

          <div>
            <label id="veteransSSN" class="usa-label" for="input-veterans-ssn">
            Veteran's Social Security Number
            </label>
            <span id="veterans-ssn" class="errors"></span>
            <input
              class="usa-input"
              id="input-veterans-ssn"
              aria-describedby="veterans-ssn"
              name="input-veterans-ssn"
              type="text"
              onkeypress="return event.keyCode != 13;"
              required
              oninvalid="this.setCustomValidity('Fill out the Veteran's Social Security Number field.')"
              oninput="this.setCustomValidity('')" />
          </div>

          <div>
            <label id="myZIP" class="usa-label" for="input-zip">
            Veteran's ZIP code
            </label>
            <span id="zip" class="errors"></span>
            <input
              class="usa-input"
              id="input-veterans-zip"
              aria-describedby="zip"
              name="input-zip"
              type="text"
              maxlength="5"
              onkeypress="return event.keyCode != 13;"
              required
              oninvalid="this.setCustomValidity('Fill out the zip field.')"
              oninput="this.setCustomValidity('')" />
          </div>

          <div class="usa-form-group">
            <label class="usa-label" for="va-pdf-form">
            Input accepts only PDF files
            </label>
            <span class="usa-hint" id="va-pdf-form-hint">
            Select one or more files
            </span>
            <input
              id="va-pdf-form"
              class="usa-file-input"
              type="file"
              name="va-pdf-form"
              aria-describedby="va-pdf-form-hint"
              accept=".pdf"
              multiple="multiple"
            />
          </div>
          
          {# <div class="usa-form-group">
            <label class="usa-label" for="va-pdf-form">
                Input accepts only PDF files
            </label>
            <span class="usa-hint" id="va-pdf-form-hint">
                Select PDF files
            </span>
            <input
                id="va-pdf-form"
                class="usa-file-input"
                type="file"
                name="va-pdf-form"
                aria-describedby="va-pdf-form-hint"
                accept=".pdf"
                multiple="multiple"
            />
          </div> #}
        </div>

        <div class="ceo-button-container">
          <button
            id="submitButton"
            class="usa-button usa-button--secondary usa-button--big ceo-button"
            type="button"
          >
            Submit Form
          </button>
        </div>
      </div>
    </div>
  </form>
</div>

<script src="/themes/custom/usagov/scripts/purify.min.js" defer></script>
<script src="/themes/custom/usagov/scripts/va-api/benefitsIntakeAPI.js" defer></script>
