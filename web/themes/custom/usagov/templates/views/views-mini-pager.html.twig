{#
/**
 * @file
 * Theme override for a views mini-pager with USWDS styling.
 *
 * This template provides USWDS-compliant pagination for Drupal's mini pager,
 * including proper navigation arrows using chevron_left and chevron_right
 * icons from the theme's sprite.svg file.
 *
 * Available variables:
 * - heading_id: Pagination heading ID.
 * - pagination_heading_level: The heading level to use for the pager.
 * - items: List of pager items.
 *
 * @see template_preprocess_views_mini_pager()
 */
#}
{% if items.previous or items.next %}
  <nav role="navigation" aria-labelledby="{{ heading_id }}" class="usa-pagination" aria-label="Pagination Navigation">
    <{{ pagination_heading_level }} id="{{ heading_id }}" class="usa-sr-only">{{ 'Pagination'|t }}</{{ pagination_heading_level }}>
    <ul class="usa-pagination__list">
      {% if items.previous %}
        <li class="usa-pagination__item usa-pagination__arrow">
          <a href="{{ items.previous.href }}"
             class="usa-pagination__link usa-pagination__previous-page"
             title="{{ 'Go to previous page'|t }}"
             rel="prev"{{ items.previous.attributes|without('href', 'title', 'rel') }}
             aria-label="{{ 'Previous page'|t }}">
            <svg class="usa-icon" aria-hidden="true" role="img">
              <use xlink:href="/themes/custom/usagov/assets/img/sprite.svg#chevron_left"></use>
            </svg>
            <span class="usa-pagination__link-text">{{ 'Previous'|t }}</span>
          </a>
        </li>
      {% endif %}

      {% if items.current %}
        <li class="usa-pagination__item usa-pagination__page-no">
          <span class="usa-pagination__button usa-current" aria-current="page" aria-label="{{ 'Page'|t }} {{ items.current }}">
            {{ items.current }}
          </span>
        </li>
      {% endif %}

      {% if items.next %}
        <li class="usa-pagination__item usa-pagination__arrow">
          <a href="{{ items.next.href }}"
             class="usa-pagination__link usa-pagination__next-page"
             title="{{ 'Go to next page'|t }}"
             rel="next"{{ items.next.attributes|without('href', 'title', 'rel') }}
             aria-label="{{ 'Next page'|t }}">
            <span class="usa-pagination__link-text">{{ 'Next'|t }}</span>
            <svg class="usa-icon" aria-hidden="true" role="img">
              <use xlink:href="/themes/custom/usagov/assets/img/sprite.svg#chevron_right"></use>
            </svg>
          </a>
        </li>
      {% endif %}
    </ul>
  </nav>
{% endif %}
