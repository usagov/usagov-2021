{#
/**
 * @file
 * Theme override to display a region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <div>.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @see template_preprocess_region()
 *
 * @ingroup themeable
 */
#}
{% if content %}
  <div{{ attributes }}>
    {# Add all blocks in the `header_top` region #}
    {{ content }}
    {{ include('@usagov/wizard_2024/wizard-mobile-navigation-include.html.twig') }}

    {# Render config_pages alerts (e.g., site banners) - pre-rendered for static site #}
    {% if config_page_alerts %}
      {% for banner_key, rendered_alert in config_page_alerts %}
        {{ rendered_alert }}
      {% endfor %}
    {% endif %}
  </div>
{% endif %}

