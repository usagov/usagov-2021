{#
/**
 * @file
 * Theme override for USWDS Alert paragraph when used in Config Pages Site Banner.
 *
 * This template is specifically for site banners created via Config Pages module,
 * and mirrors the styling and functionality of the block-based site banners.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 * - content: All paragraph items.
 * - attributes: HTML attributes for the containing element.
 * - view_mode: View mode; for example, "preview" or "full".
 * - logged_in: Flag for authenticated user status.
 * - is_admin: Flag for admin user status.
 *
 * @see template_preprocess_paragraph()
 * @ingroup themeable
 */
#}

{# The template default set classes. #}
{# Sets Paragraph ID as class. #}
{%
  set classes = [
  'paragraph',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  'paragraph--id--' ~ paragraph.id.value,
  'usa-alert',
  content.field_slim['#items'].getString() ? 'usa-alert--slim',
  content.field_no_icon['#items'].getString() ? 'usa-alert--no-icon'
]
%}

{% set alert_status = content.field_alert_status['#items'].getString() %}
{% set alert_status_class = [
  'info' == alert_status ? 'usa-alert--info',
  'warning' == alert_status ? 'usa-alert--warning',
  'error' == alert_status ? 'usa-alert--error',
  'success' == alert_status ? 'usa-alert--success'
  ]
%}

{% set classes = classes|merge(alert_status_class) %}

{{ attach_library('uswds_paragraph_components/uswds-alerts') }}

{% if node.langcode.langcode == "es" %}
  {% set translations = {
    'info': 'información',
    'warning': 'aviso',
    'error': 'error',
    'success': 'exito',
  } %}
{% else %}
  {% set translations = {
    'info': 'info',
    'warning': 'warning',
    'error': 'error',
    'success': 'success',
  } %}
{% endif %}

{# Prints div with classes, and content without Width and Background. #}
{# Added data-analytics="site-banner" attribute for consistency with block-based site banners #}
{% if alert_status %}
  {% if alert_status == "info" %}
    <div{{ attributes.addClass(classes) }} role="region" aria-label={{ translations.info }} data-analytics="site-banner">
  {% endif %}
  {% if alert_status == "warning" %}
    <div{{ attributes.addClass(classes) }} role="region" aria-label={{ translations.warning }} data-analytics="site-banner">
  {% endif %}
  {% if alert_status == "error" %}
    <div{{ attributes.addClass(classes) }} role="region" aria-label={{ translations.error }} data-analytics="site-banner">
  {% endif %}
  {% if alert_status == "success" %}
    <div{{ attributes.addClass(classes) }} role="region" aria-label={{ translations.success }} data-analytics="site-banner">
  {% endif %}
{% else %}
  <div{{ attributes.addClass(classes) }} data-analytics="site-banner">
{% endif %}
    <div class="usa-alert__body">
    {% if alert_status %}
      <span class="usa-alert__a11y-label visually-hidden" id="usa-alert--1__a11y-label">
        <svg role="img" aria-label={{ alert_status }}>
        {% if alert_status == "info" %}
          <title aria-labelledby="usa-alert--1__heading">{{translations.info}}</title>
        {% endif %}
         {% if alert_status == "warning" %}
           <title>{{translations.warning}}</title>
        {% endif %}
         {% if alert_status == "error" %}
           <title>{{translations.error}}</title>
        {% endif %}
         {% if alert_status == "success" %}
           <title>{{translations.success}}</title>
        {% endif %}
        </svg>
     </span>
    {% endif %}
    {% if not paragraph.field_alert_title.isempty %}
      <div id="usa-alert--1__heading">
        <h2 class="usa-alert__heading">{{ content.field_alert_title }}</h2>
      </div>
    {% endif %}
    {{ content.field_alert_body }}
  </div>
</div>
