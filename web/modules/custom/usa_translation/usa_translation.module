<?php

/**
 * @file
 * Self explained.
 */

use Drupal\node\NodeInterface;

/**
 * Implements hook_ENTITY_TYPE_translation_delete().
 */
function usa_translation_node_translation_delete(NodeInterface $node): void {
  $node_lang = $node->language()->getId();
  $menu_link_manager = \Drupal::service('plugin.manager.menu.link');
  $result = $menu_link_manager->loadLinksByRoute('entity.node.canonical', ['node' => $node->id()]);
  foreach ($result as $row) {
    [$entity_type, $uuid] = explode(':', $row->getPluginId(), 2);
    $menu_entity = \Drupal::service('entity.repository')->loadEntityByUuid($entity_type, $uuid);
    if ($node_lang == $menu_entity->language()->getId()) {
      $menu_entity->delete();
    }
  }
}

/**
 * Implements hook_page_attachments_alter().
 *
 * USAGOV-2946: Per the Presidential directive (2026-11-10), Spanish pages
 * redirect to English, so no alternate-language metadata is emitted. This
 * strips every hreflang rel='alternate' head link, including the ones core
 * content_translation_page_attachments() adds for each entity translation.
 * The previous implementation (conlang/altlang links) is in git history.
 *
 * @param array<string, mixed> $page
 * @param-out array<string, mixed> $page
 */
function usa_translation_page_attachments_alter(array &$page): void {
  if (empty($page['#attached']['html_head_link'])) {
    return;
  }
  $page['#attached']['html_head_link'] = array_values(array_filter(
    $page['#attached']['html_head_link'],
    static fn(array $link): bool => !(
      ($link[0]['rel'] ?? NULL) === 'alternate' && isset($link[0]['hreflang'])
    ),
  ));
}
