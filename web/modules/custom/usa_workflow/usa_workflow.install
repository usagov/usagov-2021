<?php

/**
 * @file
 * Install, update and uninstall functions for the USA Workflow module.
 */

/**
 * Enable config_pages module for USAGOV-1685 site banner migration.
 *
 * The config_pages module provides the entity type needed for the new
 * site banner implementation. This must be enabled before configuration
 * import attempts to create config_pages entity configs.
 */
function usa_workflow_update_10001() {
  \Drupal::service('module_installer')->install(['config_pages']);
  return t('Enabled config_pages module for site banner migration.');
}
