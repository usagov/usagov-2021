{# Create an array of the active trail items from each level of the menu (up to the active item) #}

{% if node.type[0].value.target_id == "directory_record" %}
  {% if node.langcode.langcode == "es" %}
    {% set active_trail = [
      {
        title: dirRecordBreadLevel1Es,
        url: "/es/acerca-de-estados-unidos",
        in_active_trail: true,
        active: false
      },
      {
        title: dirRecordBreadLevel2AgencyEs,
        url: "/es/indice-agencias",
        in_active_trail: true,
        active: false
      }
    ] %}
  {% else %}
    {% set active_trail = [
      {
        title: dirRecordBreadLevel1En,
        url: "/about-the-us",
        in_active_trail: true,
        active: false
      },
      {
        title: dirRecordBreadLevel2AgencyEn,
        url: "/agency-index",
        in_active_trail: true,
        active: false
      }
    ] %}
  {% endif %}
{% endif %}

{% if node.type[0].value.target_id == "state_directory_record" %}
  {% if node.langcode.langcode == "es" %}
    {% set active_trail = [
      {
        title: dirRecordBreadLevel1Es,
        url: "/es/acerca-de-estados-unidos",
        in_active_trail: true,
        active: false
      },
      {
        title: dirRecordBreadLevel2StateEs,
        url: "/es/gobiernos-estatales",
        in_active_trail: true,
        active: false
      },
    ] %}
  {% else %}
    {% set active_trail = [
      {
        title: dirRecordBreadLevel1En,
        url: "/about-the-us",
        in_active_trail: true,
        active: false
      },
      {
        title: dirRecordBreadLevel2StateEn,
        url: "/state-governments",
        in_active_trail: true,
        active: false
      }
    ] %}
  {% endif %}
{% endif %}


{# Build the mobile menu #}
<nav aria-label="{{ node.langcode.langcode == 'es' ?  "Navegación primaria" : "Primary navigation" }}" class="usa-nav usagov-mobile-menu">
  <div class="usa-nav__inner">
    <div class="usagov-mobile-menu-top">
      <div class="usagov-mobile-menu-controls">
        <a id="home-link-mobile-menu" href="{{ translations.home_URL }}">
          <svg class="usa-icon text-base-darkest">
            <use xlink:href="/themes/custom/usagov/assets/img/sprite.svg#home"></use>
          </svg>
          {{ translations.home }}
        </a>
        <button class="usa-nav__close">
          <svg class="usa-icon text-base-darkest">
            <use xlink:href="/themes/custom/usagov/assets/img/sprite.svg#highlight_off"></use>
          </svg>
          {{ translations.close }}
        </button>
      </div>
      <div class="usa-nav__secondary">
        <!-- Search Bar -->
        {% embed 'usagov:searchbar' with {
          form_classes: "usa-search usa-search--small",
          label_id: "top-srch-mobile-menu",
          for_string:"search-field-small-mobile-menu",
          hidden_input_id:"affiliate-mobile-menu",
          input_id:"search-field-small-mobile-menu",
          input_classes:"usa-input text usagov-search-autocomplete ui-autocomplete-input",
          button_classes:"usa-button usagov-button",
          placeholder_string,
          value_string,
          label_string,
          alt_string,
        } %}
          {% set form_id = translations.form_id %}
          {% set placeholder_string = translations.search_placeholder %}
          {% set value_string = translations.search_affiliate %}
          {% set label_string = translations.search %}
          {% set alt_string = translations.search %}
        {% endembed %}
        <div class="usa-nav__secondary-links">
          {{ drupal_region('top_nav_mobile') }}
        </div>
      </div>

      {# Blog instruction text for mobile - only show on blog pages #}
      {% set content_type = "" %}
      {% if node.type.0 != null %}
        {% set content_type = node.type.0.target_id %}
      {% endif %}
      {% set current_path = path('<current>') %}
      {% set is_blog_view = '/blog' in current_path %}
      {% if is_blog_view or content_type == 'blog_post' %}
        <div class="blog-instruction-mobile">
          <p class="margin-x-2 margin-y-1 text-base font-sans-xs">Learn about the priorities, research, challenges, and great discoveries that shape the way USAGov connects people with government services and programs. Select year and/or month to see the blog entries from the selected year/month.</p>
        </div>
      {% endif %}
    </div>

    {% block mobile_nav %}
      {# Build the mobile nav #}
      {% if active_trail is empty %}
        {#
        The current page is not in the menu structure.
        Show All Topics and Services
        #}
        <ul class="navigation__items ancestors">
          <li class="navigation__item active">
            <a href="{{ translations.home_URL }}#all-topics-header">{{ translations.all_topics }}</a>
            <ul class="navigation__items children">
              {% for menu_item in submenu %}
                <li class="navigation__item child">
                  <a href="{{ menu_item.url }}">{{ menu_item.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </li>
        </ul>

      {% else %}
        <ul class="navigation__items ancestors">
          {% for menu_item in active_trail %}

            {% set class = "" %}

            {# The first item is an umbrella category unless it is the current page #}
            {% if loop.index == 1 %}
              {% set class = " umbrella" %}
            {% endif %}

            {# The current page #}
            {% if menu_item.active %}
              {% set class = " active" %}
            {% endif %}

            {# Show the first item and up to 3 items at the end of the active trail #}
            {# For blog menu, detect by checking if first item has /blog URL and show ALL items #}
            {% set is_blog_menu = active_trail[0].url is defined and '/blog' in active_trail[0].url|render|striptags %}
            {% if is_blog_menu %}
              {% set show_this_item = true %}
            {% else %}
              {% set show_this_item = (loop.index == 1 or loop.index + 3 > active_trail|length) %}
            {% endif %}

            {% if show_this_item %}
              {% if found_active_item and not active_item_has_children and loop.index == active_trail|length %}
                {# The current page has no children, so we should show its siblings instead #}
                <li class="navigation__item">
                  <ul class="navigation__items">
                    {% for child in siblings_of_active_item %}
                      {% set class = "" %}
                      {% if child.active %}
                        {% set class = " active" %}
                      {% else %}
                        {% set class = " sibling" %}
                      {% endif %}
                      <li class="navigation__item{{ class }}">
                        <a href="{{ child.active ? "#" : child.url }}">{{ child.title }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                </li>
              {% else %}
                <li class="navigation__item{{ class }}">
                  <a href="{{ menu_item.active ? "#" : menu_item.url }}">{{ menu_item.title }}</a>
                  {# Show children - for blog menu, show ALL children even if not active #}
                  {% if menu_item.below is not empty %}
                    {% if is_blog_menu %}
                      {# Blog menu - year items expand inline to show months without a page reload #}
                      <ul class="navigation__items children">
                        {% for child in menu_item.below %}
                          {# Year items - months are nested and hidden until the year is expanded #}
                          {% set year_expanded = child.in_active_trail or child.active %}
                          <li class="navigation__item child blog-year{% if child.active %} active{% endif %}">
                            <a href="{{ child.url }}" data-blog-year-link aria-expanded="{{ year_expanded ? 'true' : 'false' }}" style="padding-left: 1rem;">{{ child.title }}</a>
                            {% if child.below is not empty %}
                              <ul class="navigation__items children blog-months-list"{% if not year_expanded %} hidden{% endif %}>
                                {% for grandchild in child.below %}
                                  {# Month items - clicking navigates to the month archive page #}
                                  <li class="navigation__item child blog-month{% if grandchild.active %} active{% endif %}">
                                    <a href="{{ grandchild.url }}" style="padding-left: 2rem;">{{ grandchild.title }}</a>
                                  </li>
                                  {# Show posts if this month is active #}
                                  {% if grandchild.in_active_trail and grandchild.below is not empty %}
                                    {% for post in grandchild.below %}
                                      {# Post items - add active class if this is the active post #}
                                      <li class="navigation__item child blog-post{% if post.active %} active{% endif %}">
                                        <a href="{{ post.active ? '#' : post.url }}" style="padding-left: 3rem;">{{ post.title }}</a>
                                      </li>
                                    {% endfor %}
                                  {% endif %}
                                {% endfor %}
                              </ul>
                            {% endif %}
                          </li>
                        {% endfor %}
                      </ul>
                    {% elseif menu_item.active %}
                      {# Non-blog menu - only show children if active #}
                      <ul class="navigation__items children">
                        {% for child in menu_item.below %}
                          <li class="navigation__item child">
                            <a href="{{ child.url }}">{{ child.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  {% endif %}

                  {# Show the current page if this is the last iteration but the active item was never found #}
                  {% if loop.index == active_trail|length and not found_active_item %}
                    <ul class="navigation__items">
                      {% if menu_item.below is not empty %}
                        {% for child in menu_item.below %}
                          <li class="navigation__item sibling">
                            <a href="{{ child.url }}">{{ child.title }}</a>
                          </li>
                        {% endfor %}
                      {% endif %}
                      <li class="navigation__item active">
                        <a href="#">{{ node.title.value }}</a>
                      </li>
                    </ul>
                  {% endif %}
                </li>
              {% endif %}

            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    {% endblock %}

  </div>
</nav>
